<section class="sustainability-marquee-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};">
  
  {% if section.settings.title != blank %}
    <div class="page-width">
      <div class="marquee-header text-center">
        <h2 class="marquee-section-heading">{{ section.settings.title }}</h2>
      </div>
    </div>
  {% endif %}

  <div class="marquee-wrapper scroll-{{ section.settings.direction }}">
    <div class="marquee-track" style="animation-duration: {{ section.settings.speed }}s;">
      
      <!-- Track 1 -->
      <div class="marquee-content">
        {% for block in section.blocks %}
          <div class="marquee-card" {{ block.shopify_attributes }} 
               style="background-color: {{ block.settings.card_bg }}; color: {{ block.settings.card_text_color }};">
            
            <div class="card-icon" style="color: {{ block.settings.card_text_color }};">
              {% if block.settings.custom_svg != blank %}
                {{ block.settings.custom_svg }}
              {% elsif block.settings.custom_image != blank %}
                <img src="{{ block.settings.custom_image | image_url: width: 80 }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                {% case block.settings.icon_type %}
                  {% when 'sun' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="4"/>
                      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                    </svg>
                  {% when 'wind' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22V11"/>
                      <path d="M12 11l5-5M12 11l-5-5M12 11v-7"/>
                      <circle cx="12" cy="11" r="1.5"/>
                    </svg>
                  {% when 'tree' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2L19 10H15L21 16H3L9 16L5 10H12z"/>
                      <path d="M12 16v5"/>
                    </svg>
                  {% when 'wheat' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22V2M8 5a2 2 0 0 1 4 0M16 5a2 2 0 0 0-4 0M8 10a2 2 0 0 1 4 0M16 10a2 2 0 0 0-4 0M8 15a2 2 0 0 1 4 0M16 15a2 2 0 0 0-4 0"/>
                    </svg>
                  {% when 'biogas' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2C7.5 5 5 9 5 13a7 7 0 0 0 14 0c0-4-2.5-8-7-11z"/>
                      <path d="M12 17c-1.5 0-3-1-3-2.5"/>
                    </svg>
                  {% when 'drop' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-13-7-13S5 10.7 5 15a7 7 0 0 0 7 7z"/>
                    </svg>
                  {% when 'trash' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                      <path d="M12 11v6M9 11v6M15 11v6"/>
                    </svg>
                  {% when 'leaf' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 21 3c-1 4.5-2.5 6-7 11.8A7 7 0 0 1 11 20z"/>
                      <path d="M9 22l3-3"/>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            <div class="card-label">
              {{ block.settings.title }}
            </div>
            
          </div>
        {% endfor %}
      </div>

      <!-- Track 2 (Seamless copy) -->
      <div class="marquee-content" aria-hidden="true">
        {% for block in section.blocks %}
          <div class="marquee-card" 
               style="background-color: {{ block.settings.card_bg }}; color: {{ block.settings.card_text_color }};">
            
            <div class="card-icon" style="color: {{ block.settings.card_text_color }};">
              {% if block.settings.custom_svg != blank %}
                {{ block.settings.custom_svg }}
              {% elsif block.settings.custom_image != blank %}
                <img src="{{ block.settings.custom_image | image_url: width: 80 }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                {% case block.settings.icon_type %}
                  {% when 'sun' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="4"/>
                      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                    </svg>
                  {% when 'wind' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22V11"/>
                      <path d="M12 11l5-5M12 11l-5-5M12 11v-7"/>
                      <circle cx="12" cy="11" r="1.5"/>
                    </svg>
                  {% when 'tree' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2L19 10H15L21 16H3L9 16L5 10H12z"/>
                      <path d="M12 16v5"/>
                    </svg>
                  {% when 'wheat' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22V2M8 5a2 2 0 0 1 4 0M16 5a2 2 0 0 0-4 0M8 10a2 2 0 0 1 4 0M16 10a2 2 0 0 0-4 0M8 15a2 2 0 0 1 4 0M16 15a2 2 0 0 0-4 0"/>
                    </svg>
                  {% when 'biogas' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2C7.5 5 5 9 5 13a7 7 0 0 0 14 0c0-4-2.5-8-7-11z"/>
                      <path d="M12 17c-1.5 0-3-1-3-2.5"/>
                    </svg>
                  {% when 'drop' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-13-7-13S5 10.7 5 15a7 7 0 0 0 7 7z"/>
                    </svg>
                  {% when 'trash' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                      <path d="M12 11v6M9 11v6M15 11v6"/>
                    </svg>
                  {% when 'leaf' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 21 3c-1 4.5-2.5 6-7 11.8A7 7 0 0 1 11 20z"/>
                      <path d="M9 22l3-3"/>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            <div class="card-label">
              {{ block.settings.title }}
            </div>
            
          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<style>
.sustainability-marquee-section {
  overflow: hidden;
  position: relative;
  width: 100%;
}

.marquee-header {
  margin-bottom: 30px;
}

.marquee-section-heading {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 600;
  margin: 0;
}

.marquee-wrapper {
  display: flex;
  overflow: hidden;
  width: 100%;
  position: relative;
  user-select: none;
  mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
}

.marquee-track {
  display: flex;
  width: max-content;
  flex-shrink: 0;
  gap: 20px;
}

.marquee-content {
  display: flex;
  flex-shrink: 0;
  gap: 20px;
  align-items: center;
  justify-content: space-around;
  padding: 10px 0;
}

/* Scroll Direction Animation */
.scroll-left .marquee-track {
  animation: marquee-scroll-left linear infinite;
}

.scroll-right .marquee-track {
  animation: marquee-scroll-right linear infinite;
}

@keyframes marquee-scroll-left {
  0% {
    transform: translate3d(0, 0, 0);
  }
  100% {
    transform: translate3d(calc(-50% - 10px), 0, 0);
  }
}

@keyframes marquee-scroll-right {
  0% {
    transform: translate3d(calc(-50% - 10px), 0, 0);
  }
  100% {
    transform: translate3d(0, 0, 0);
  }
}

/* Pause scroll on hover */
.marquee-wrapper:hover .marquee-track {
  animation-play-state: paused;
}

/* Marquee Card Styling */
.marquee-card {
  width: 180px;
  height: 200px;
  border-radius: 20px;
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  text-align: center;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  flex-shrink: 0;
}

.marquee-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
}

.marquee-card .card-icon {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.marquee-card .card-icon svg {
  width: 100%;
  height: 100%;
}

.marquee-card .card-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.marquee-card .card-label {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.3;
  margin: 0;
}

/* Responsive adjust */
@media (max-width: 767px) {
  .marquee-card {
    width: 140px;
    height: 160px;
    border-radius: 16px;
    padding: 20px 15px;
  }
  .marquee-card .card-icon {
    width: 38px;
    height: 38px;
  }
  .marquee-card .card-label {
    font-size: 12px;
  }
}
</style>

{% schema %}
{
  "name": "Sustainability Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Eco Initiatives"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "left",
          "label": "Right to Left"
        },
        {
          "value": "right",
          "label": "Left to Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed (smaller is faster)",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Marquee Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Wind power"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background",
          "default": "#064e6b"
        },
        {
          "type": "color",
          "id": "card_text_color",
          "label": "Card Text & Icon Color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Solar/Sun" },
            { "value": "wind", "label": "Wind Turbine" },
            { "value": "tree", "label": "Pine Tree" },
            { "value": "wheat", "label": "Wheat/Crops" },
            { "value": "biogas", "label": "Biogas/Gas" },
            { "value": "drop", "label": "Water Drop" },
            { "value": "trash", "label": "Recycle Bin" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "wind"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon Image (Optional)"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sustainability Marquee",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Solar power",
            "card_bg": "#ffeacc",
            "card_text_color": "#8c4f00",
            "icon_type": "sun"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Wind power",
            "card_bg": "#0d567c",
            "card_text_color": "#ffffff",
            "icon_type": "wind"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Forest management",
            "card_bg": "#d6f272",
            "card_text_color": "#1c3800",
            "icon_type": "tree"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Agricultural methane capture",
            "card_bg": "#5b3713",
            "card_text_color": "#fed89c",
            "icon_type": "wheat"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Biogas",
            "card_bg": "#bce6ff",
            "card_text_color": "#074872",
            "icon_type": "biogas"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Oil recycling",
            "card_bg": "#2b264e",
            "card_text_color": "#d9ceff",
            "icon_type": "drop"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Landfill gas methane capture",
            "card_bg": "#095311",
            "card_text_color": "#d2ffd6",
            "icon_type": "trash"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Solar power",
            "card_bg": "#ffe680",
            "card_text_color": "#5b4000",
            "icon_type": "sun"
          }
        }
      ]
    }
  ]
}
{% endschema %}
