<section class="product-steps-section">
  <div class="page-width">

    <div class="product-steps-wrapper">

      <!-- Left Image -->
      <div class="product-steps-image">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="Steps Image"
            loading="lazy"
          >
        {% endif %}
      </div>

      <!-- Right Content -->
      <div class="product-steps-content">

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="steps-richtext">
          {{ section.settings.content }}
        </div>

      </div>

    </div>

  </div>
</section>

<style>
.product-steps-section{
  padding:40px 10px;
  background:#FCFAF7;
}

.product-steps-section .page-width{
  max-width:1299px;
  margin:0 auto;
}

.product-steps-wrapper{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:24px;
  align-items:flex-start;
}

.product-steps-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  border-radius:18px;
}

.product-steps-content{
  background:#fff;
  border-radius:18px;
  padding:20px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.product-steps-content h2{
  font-size:clamp(30px,4vw,54px);
  line-height:1.1;
  margin-bottom:30px;
  color:#111;
}

.steps-richtext{
  font-size:clamp(16px,1.5vw,20px);
  line-height:1.9;
  color:#111;
}

.steps-richtext p {
    margin-bottom: 22px;
    font-size: 16px;
}

/* Tablet */
@media(max-width:991px){

  .product-steps-wrapper{
    grid-template-columns:1fr;
  }

  .product-steps-content{
    padding:45px;
  }

}

/* Mobile */
@media(max-width:768px){

  .product-steps-section{
    padding:50px 15px;
  }

  .product-steps-content{
    padding:28px 24px;
    border-radius:14px;
  }

  .product-steps-image img{
    border-radius:14px;
  }

  .steps-richtext{
    line-height:1.7;
  }

}
/* DESKTOP FIX SCROLL EFFECT */
@media(min-width:992px){

  .product-steps-wrapper{
    align-items:flex-start;
  }

  .product-steps-image{
    position:sticky;
    top:120px;
    height:fit-content;
  }

 
}
</style>

{% schema %}
{
  "name": "Product Steps",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How To Use"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Step 1: Wet your hair and apply shampoo gently.</p><p>Step 2: Rinse thoroughly and follow with conditioner.</p>"
    }
  ],
  "presets": [
    {
      "name": "Product Steps"
    }
  ]
}
{% endschema %} 