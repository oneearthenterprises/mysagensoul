{% schema %}
{
  "name": "Blend Benefits Slider",
  "tag": "section",
  "class": "section blend-benefits-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blends with Benefits"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ead8c9"
    }
  ],
  "presets": [
    {
      "name": "Blend Benefits Slider"
    }
  ]
}
{% endschema %}

{% assign items = product.metafields.custom.blend_benefit_item.value %}

{% if items != blank %}

<section class="blend-benefits-wrap">




  <div class="page-width">

    <h2 class="blend-benefits-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="blend-slider-main">

      <!-- Left Arrow -->
      <div class="blend-arrow blend-prev221">
        &#10094;
      </div>

      <div class="swiper blendBenefitsSlider">
        <div class="swiper-wrapper">

          {% for item in items %}
          <div class="swiper-slide">

            <div class="benefit-card">

              {% if item.icon != blank %}
              <div class="benefit-icon">
                <img
                  src="{{ item.icon | image_url: width: 200 }}"
                  alt="{{ item.description }}"
                  loading="lazy" width="" height="">
              </div>
              {% endif %}

              {% if item.description != blank %}
              <p>{{ item.description }}</p>
              {% endif %}

            </div>

          </div>
          {% endfor %}

        </div>
      </div>

      <!-- Right Arrow -->
      <div class="blend-arrow blend-next221">
        &#10095;
      </div>

    </div>

  </div>
</section>

{% endif %}

<style>
.blend-benefits-section{
  background:{{ section.settings.bg }};
}
.blend-benefits-wrap{
  position: relative;
  overflow: hidden; /* important */
}

/* main wrapper full width */
.main-cup{
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* common image style */
.main-cup img{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 220px; /* adjust size */
  opacity: 0.70; /* optional premium look */
}


/* RIGHT image - bilkul edge pe */
.main-cup .right{
  right: 0;
}

.blend-benefits-wrap{
  padding:70px 0;
}

.blend-benefits-heading{
  text-align:center;
  font-size:42px;
  font-weight:700;
  margin:0 0 45px;
  color:#222;
}

.blend-slider-main {
    display: flex;
    align-items: center;
    gap: 0px;
}

.blendBenefitsSlider{
  overflow:hidden;
  flex:1;
}

.benefit-card{
  text-align:center;
}

.benefit-icon{
  margin-bottom:18px;
}

.benefit-icon img{
  width:105px;
  height:105px;
  object-fit:contain;
  display:block;
  margin:auto;
}

.benefit-card p{
  font-size:15px;
  line-height:1.35;
  color:#333333;
  margin:0 auto;
 
}

/* arrows */
.blend-arrow{
  width:42px;
  height:42px;
  border-radius:50%;
  background:#fff;
  color:#222;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  font-size:22px;
  font-weight:700;
  box-shadow:0 4px 14px rgba(0,0,0,.08);
  flex-shrink:0;
  transition:.3s;
}

.blend-arrow:hover{
  transform:scale(1.08);
}

@media(max-width:768px){

.blend-benefits-wrap{
  padding:50px 0;
}

.blend-benefits-heading{
  font-size:32px;
  margin-bottom:25px;
}

.benefit-card p{
  font-size:11px;
  {% comment %} max-width:140px; {% endcomment %}
}

.benefit-icon img{
  width:70px;
  height:70px;
}

.blend-arrow{
  display: none !important;
}

}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var isHomePage = {% if template == 'index' or template.name == 'index' or request.page_type == 'index' %}true{% else %}false{% endif %};
  var options = {
    slidesPerView: 2,
    spaceBetween: 20,
    loop: true,
    speed: 800,
    autoplay:{
      delay:2500,
      disableOnInteraction:false
    },
    navigation:{
      nextEl: ".blend-next221",
      prevEl: ".blend-prev221"
    },
    breakpoints:{
      768:{ slidesPerView:4 },
      991:{ slidesPerView:4 }
    }
  };
  new Swiper(".blendBenefitsSlider", options);
});
</script>