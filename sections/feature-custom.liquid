{% assign selected_collection = collections[section.settings.collection] %}
{% assign manual_products = section.settings.products %}

{% if selected_collection != blank or manual_products != blank %}

<section
  id="shopify-section-{{ section.id }}"
  class="shopify-section section xy-slider-section color-{{ section.settings.color_scheme }}"
>

  <div class="page-width xy-wrap-{{ section.id }}">

    {% if section.settings.heading != blank %}
      <h2 class="xy-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <!-- ░░ STAGE ░░ -->
    <div class="xy-stage-{{ section.id }}" id="xy-stage-{{ section.id }}">

    <!-- ░░ SKELETON LOADER ░░ -->
    <div class="xy-skeleton-wrap xy-skeleton-{{ section.id }}" id="xy-skeleton-{{ section.id }}">
      {% for i in (1..4) %}
        <div class="xy-skeleton-card">
          <div class="xy-skel xy-skel-img"></div>
          <div class="xy-skel xy-skel-tags"></div>
          <div class="xy-skel xy-skel-title"></div>
          <div class="xy-skel xy-skel-title xy-skel-title--short"></div>
          <div class="xy-skel xy-skel-price"></div>
          <div class="xy-skel xy-skel-btn"></div>
        </div>
      {% endfor %}
    </div>

    <!-- ░░ REAL SLIDER / GRID ░░ -->
    <div
      class="swiper xySwiper-{{ section.id }}"
      id="xy-swiper-{{ section.id }}"
      aria-label="{{ section.settings.heading | escape }}"
      data-mobile-layout="{{ section.settings.mobile_layout }}"
      data-tablet-layout="{{ section.settings.tablet_layout }}"
      data-desktop-layout="{{ section.settings.desktop_layout }}"
      data-mobile-cols="{{ section.settings.mobile }}"
      data-tablet-cols="{{ section.settings.tablet }}"
      data-desktop-cols="{{ section.settings.desktop }}"
    >
      <div class="swiper-wrapper">

        {% if manual_products != blank %}
          {% for product in manual_products limit: section.settings.limit %}
            <div class="swiper-slide">
              <div class="xy-card">
                <!-- IMAGE CAROUSEL -->
                <div class="xy-img-slider" data-xy-img-slider>
                  <!-- ::before pseudo-element creates the 1:1 height (iPhone safe) -->
                  <div class="xy-img-track">
                    {% for image in product.images limit: 6 %}
                      <div class="xy-img-item{% if forloop.first %} is-active{% endif %}">
                        <a href="{{ product.url }}">
                          {% comment %} <img
                            src="{{ image | image_url: width: 600 }}"
                            alt="{{ image.alt | default: product.title | escape }}"
                            loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}"
                            width="600"
                            height="600"
                            draggable="false"
                          > {% endcomment %}


                          <img
  src="{{ image | image_url: width: 400 }}"
  srcset="
    {{ image | image_url: width: 165 }} 165w,
    {{ image | image_url: width: 240 }} 240w,
    {{ image | image_url: width: 326 }} 326w,
    {{ image | image_url: width: 400 }} 400w,
    {{ image | image_url: width: 600 }} 600w
  "
  sizes="(max-width: 768px) 326px, 600px"
  alt="{{ image.alt | default: product.title | escape }}"
  loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}"
  width="600"
  height="600"
  draggable="false"
/>
                        </a>
                      </div>
                    {% endfor %}
                  </div>
                  {% if product.images.size > 1 %}
                    <button class="xy-img-arrow xy-img-arrow--prev" aria-label="Previous image" type="button">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                    <button class="xy-img-arrow xy-img-arrow--next" aria-label="Next image" type="button">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                    <div class="xy-img-dots" aria-hidden="true">
                      {% for image in product.images limit: 6 %}
                        <button class="xy-dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Image {{ forloop.index }}"></button>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if product.compare_at_price > product.price and section.settings.show_discount %}
                    {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                    <div class="xy-badge">{{ discount | round }}% OFF</div>
                  {% endif %}
                </div>
                <!-- TITLE -->
                <h3 class="xy-title">
                  <a href="{{ product.url }}">
                    {% if product.title.size > 40 %}{{ product.title | slice: 0, 40 }}...{% else %}{{ product.title }}{% endif %}
                  </a>
                </h3>
                <!-- TAGS -->
                {% if product.metafields.custom.product_tabel221.value != blank %}
                  <div class="xy-tag-scroll" aria-label="Product features">
                    {% for item in product.metafields.custom.product_tabel221.value %}
                      <span class="xy-tag-item">{{ item }}</span>
                    {% endfor %}
                  </div>
                {% endif %}
                <!-- REVIEWS -->
                {% if section.settings.show_reviews %}
                  <div class="xy-review">
                    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-init="false">{{ product.metafields.judgeme.badge }}</div>
                  </div>
                {% endif %}
                <!-- PRICE -->
                <div class="xy-price-wrap">
                  <span class="xy-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="xy-compare">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
                <!-- BUTTONS -->
                <div class="xy-btn-wrap">
                  {% if section.settings.show_cart %}
                    {% assign can_add = product.selected_or_first_available_variant.available %}
                    <form method="post" action="/cart/add" class="xy-cart-form" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      {% render 'add-to-cart-button', can_add_to_cart: can_add, product: product, add_to_cart_text: section.settings.cart_text, class: 'button-secondary' %}
                    </form>
                  {% endif %}
                  {% if section.settings.show_buy %}
                    <form class="xy-buy-form">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="xy-buy-btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                        {% if product.selected_or_first_available_variant.available %}
                          {{ section.settings.buy_text }}
                        {% else %}
                          Sold out
                        {% endif %}
                      </button>
                    </form>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}

        {% else %}
          {% for product in selected_collection.products limit: section.settings.limit %}
            <div class="swiper-slide">
              <div class="xy-card">
                <!-- IMAGE CAROUSEL -->
                <div class="xy-img-slider" data-xy-img-slider>
                  <div class="xy-img-track">
                    {% for image in product.images limit: 6 %}
                      <div class="xy-img-item{% if forloop.first %} is-active{% endif %}">
                        <a href="{{ product.url }}">
                          <img
                            src="{{ image | image_url: width: 600 }}"
                            alt="{{ image.alt | default: product.title | escape }}"
                            loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}"
                            width="600"
                            height="600"
                            draggable="false"
                          >
                        </a>
                      </div>
                    {% endfor %}
                  </div>
                  {% if product.images.size > 1 %}
                    <button class="xy-img-arrow xy-img-arrow--prev" aria-label="Previous image" type="button">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                    <button class="xy-img-arrow xy-img-arrow--next" aria-label="Next image" type="button">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                    <div class="xy-img-dots" aria-hidden="true">
                      {% for image in product.images limit: 6 %}
                        <button class="xy-dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Image {{ forloop.index }}"></button>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if product.compare_at_price > product.price and section.settings.show_discount %}
                    {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                    <div class="xy-badge">{{ discount | round }}% OFF</div>
                  {% endif %}
                </div>
                <!-- TITLE -->
                <h3 class="xy-title">
                  <a href="{{ product.url }}">
                    {% if product.title.size > 37 %}{{ product.title | slice: 0, 37 }}…{% else %}{{ product.title }}{% endif %}
                  </a>
                </h3>
                <!-- TAGS -->
                {% if product.metafields.custom.product_tabel221.value != blank %}
                  <div class="xy-tag-scroll" aria-label="Product features">
                    {% for item in product.metafields.custom.product_tabel221.value %}
                      <span class="xy-tag-item">{{ item }}</span>
                    {% endfor %}
                  </div>
                {% endif %}
                <!-- REVIEWS -->
                {% if section.settings.show_reviews %}
                  <div class="xy-review">
                    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-init="false">{{ product.metafields.judgeme.badge }}</div>
                  </div>
                {% endif %}
                <!-- PRICE -->
                <div class="xy-price-wrap">
                  <span class="xy-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="xy-compare">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
                <!-- BUTTONS -->
                <div class="xy-btn-wrap">
                  {% if section.settings.show_cart %}
                    {% assign can_add = product.selected_or_first_available_variant.available %}
                    <form method="post" action="/cart/add" class="xy-cart-form" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      {% render 'add-to-cart-button', can_add_to_cart: can_add, product: product, add_to_cart_text: section.settings.cart_text, class: 'button-secondary' %}
                    </form>
                  {% endif %}
                  {% if section.settings.show_buy %}
                    <form class="xy-buy-form">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="xy-buy-btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                        {% if product.selected_or_first_available_variant.available %}
                          {{ section.settings.buy_text }}
                        {% else %}
                          Sold out
                        {% endif %}
                      </button>
                    </form>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}

      </div>

      <!-- NAV ARROWS (slider only) -->
      <button class="xy-nav-btn xy-nav-btn--prev" id="xyPrev-{{ section.id }}" aria-label="Previous products" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="xy-nav-btn xy-nav-btn--next" id="xyNext-{{ section.id }}" aria-label="Next products" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      {% comment %} <div class="swiper-pagination xy-pagination-{{ section.id }}" role="tablist" aria-label="Slider pagination"></div> {% endcomment %}
    </div>
    </div>

  </div>
</section>

{% endif %}


<!-- ░░░░░░░░░  STYLES  ░░░░░░░░░ -->
<style>

/* ─── SECTION ─── */
.xy-slider-section {
  padding: {{ section.settings.padding }}px 0;
  position: relative;
}
.xy-wrap-{{ section.id }} {
  overflow: hidden;
  position: relative;
}
@media (max-width: 767px) {
  .xy-slider-section { padding: 15px 0 !important; }
  .xy-wrap-{{ section.id }} { overflow: visible; }
}

/* ─── HEADING ─── */
.xy-heading {
  font-size: {{ section.settings.heading_size }}px;
  font-weight: 700;
  margin: 0 0 24px;
  line-height: 1.2;
}
@media (max-width: 767px) {
  .xy-heading {
    font-size: clamp(18px, 5vw, {{ section.settings.heading_size }}px);
    margin: 0 0 16px;
  }
}

/* ─── STAGE ─── */
.xy-stage-{{ section.id }} { position: relative; }

/* ─── SKELETON ─── */
.xy-skeleton-{{ section.id }} {
  display: grid;
  gap: 16px;
  padding: 0 20px;
  grid-template-columns: repeat({{ section.settings.mobile }}, 1fr);
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  z-index: 5;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
@media (max-width: 767px) {
  .xy-skeleton-{{ section.id }} { padding: 0; gap: 12px; }
  .xy-img-dots {

    display: none !important;
}
}
@media (min-width: 768px) {
  .xy-skeleton-{{ section.id }} { grid-template-columns: repeat({{ section.settings.tablet }}, 1fr); }
}
@media (min-width: 1024px) {
  .xy-skeleton-{{ section.id }} { grid-template-columns: repeat({{ section.settings.desktop }}, 1fr); }
}
.xy-skeleton-{{ section.id }}.is-hidden {
  opacity: 0; visibility: hidden; pointer-events: none;
}
.xy-skeleton-card {
  background: #fff; border-radius: 18px; padding: 12px; border: 1px solid #efefef;
}
@media (max-width: 767px) {
  .xy-skeleton-card { border-radius: 14px; padding: 8px; }
}
@keyframes xy-shimmer {
  0%   { background-position: -600px 0; }
  100% { background-position:  600px 0; }
}
.xy-skel {
  border-radius: 10px;
  background: linear-gradient(90deg, #f3f3f3 25%, #e8e8e8 50%, #f3f3f3 75%);
  background-size: 600px 100%;
  animation: xy-shimmer 1.6s ease infinite;
}
.xy-skel-img          { height: 220px; margin-bottom: 12px; }
.xy-skel-tags         { height: 28px;  margin-bottom: 10px; border-radius: 999px; }
.xy-skel-title        { height: 14px;  margin-bottom: 8px; }
.xy-skel-title--short { width: 65%; }
.xy-skel-price        { height: 22px;  width: 55%; margin-bottom: 16px; }
.xy-skel-btn          { height: 48px;  border-radius: 999px; }
@media (max-width: 767px) {
  .xy-skel-img { height: 180px; }
  .xy-skel-btn { height: 40px; }
}

/* ─── SWIPER CONTAINER ─── */
.xySwiper-{{ section.id }} {
  width: 100%;
  box-sizing: border-box;
  visibility: hidden;
  overflow: hidden;
}
.xySwiper-{{ section.id }}.xy-ready {
  visibility: visible;
  animation: xy-fadein 0.35s ease forwards;
}
@keyframes xy-fadein {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ── GRID MODE ── */
.xySwiper-{{ section.id }}.xy-grid-mode { overflow: visible !important; }
.xySwiper-{{ section.id }}.xy-grid-mode .swiper-wrapper {
  display: grid !important;
  transform: none !important;
  flex-wrap: unset;
  gap: 16px;
}
.xySwiper-{{ section.id }}.xy-grid-mode .swiper-slide { width: auto !important; margin: 0 !important; }
.xySwiper-{{ section.id }}.xy-grid-mode .swiper-wrapper {
  grid-template-columns: repeat(var(--xy-grid-cols, 2), 1fr);
}
@media (max-width: 767px) {
  .xySwiper-{{ section.id }}.xy-grid-mode .swiper-wrapper {
    grid-template-columns: repeat(var(--xy-grid-cols-mobile, 2), 1fr);
    gap: 5px; padding: 0;
  }
}
@media (min-width: 768px) and (max-width: 1023px) {
  .xySwiper-{{ section.id }}.xy-grid-mode .swiper-wrapper {
    grid-template-columns: repeat(var(--xy-grid-cols-tablet, 3), 1fr);
  }
}
@media (min-width: 1024px) {
  .xySwiper-{{ section.id }}.xy-grid-mode .swiper-wrapper {
    grid-template-columns: repeat(var(--xy-grid-cols-desktop, 4), 1fr);
  }
}
.xySwiper-{{ section.id }}.xy-grid-mode ~ .xy-nav-btn,
.xy-grid-mode .xy-nav-btn,
.xy-grid-mode ~ .xy-pagination-{{ section.id }} { display: none !important; }
.xySwiper-{{ section.id }}.xy-grid-mode + .xy-nav-btn { display: none; }
.xy-stage-{{ section.id }}:has(.xy-grid-mode) .xy-nav-btn { display: none !important; }
.xy-stage-{{ section.id }}:has(.xy-grid-mode) .xy-pagination-{{ section.id }} { display: none !important; }

@media (max-width: 767px) {
  .xySwiper-{{ section.id }} { overflow: visible; }
  .xy-stage-{{ section.id }} { overflow: hidden; }
}
.xySwiper-{{ section.id }} .swiper-wrapper { align-items: stretch; }
.xySwiper-{{ section.id }} .swiper-slide   { height: auto; display: flex; }

/* ─── CARD ─── */
.xy-card {
  background: #fff;
  border-radius: 20px;
  padding: 10px;
  border: 1px solid #ececec;
  display: flex;
  flex-direction: column;
  width: 100%;
  /* iOS Safari: overflow+translate3d forces GPU layer so border-radius clips children */
  overflow: hidden;
  isolation: isolate;
  -webkit-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}
.xy-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.10); transform: translateY(-2px); }
@media (max-width: 767px) {
  .xy-card {
    border-radius: 10px;
    padding: 4px;
    overflow: hidden;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }
  .xy-card:hover { box-shadow: none; transform: none; }
}

/* ─── IMAGE SLIDER ─────────────────────────────────────────
   KEY iPhone fix:
   - DO NOT use aspect-ratio: 1/1 alone — Safari <15 ignores it
     on flex children, causing 0-height containers.
   - Instead: position:relative wrapper + ::before padding-top:100%
     creates a real square height on ALL iOS versions.
   - Track is position:absolute, fills the real height.
   - translate3d(0,0,0) on both wrapper and track creates GPU layers
     so overflow:hidden + border-radius correctly clips the image.
─────────────────────────────────────────────────────────── */
.xy-img-slider {
  position: relative;
  overflow: hidden;
  border-radius: 14px;
  margin-bottom: 14px;
  background: #f8f8f8;
  width: 100%;
  user-select: none;
  -webkit-user-select: none;
  isolation: isolate;
  -webkit-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
}

/* Pseudo-element forces the square height on every iOS/Safari version */
.xy-img-slider::before {
  content: "";
  display: block;
  padding-top: 100%; /* 1:1 square ratio */
}

@media (max-width: 767px) {
  .xy-img-slider { border-radius: 10px; margin-bottom: 10px; }
}

/* ─── IMAGE TRACK ─── */
/* Absolutely fills the wrapper height created by ::before */
.xy-img-track {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  will-change: transform;
  -webkit-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
  transition: transform 0.38s cubic-bezier(0.4,0,0.2,1);
}

.xy-img-item {
  min-width: 100%;
  flex-shrink: 0;
  height: 100%;
  position: relative;
}
.xy-img-item a {
  display: block;
  width: 100%;
  height: 100%;
}
.xy-img-item img {
  /* Absolute fill — works because parent has real height from ::before */
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none;
  /* GPU layer prevents white flash on image slide transition (iPhone) */
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* ─── IMAGE ARROWS ─── */
.xy-img-arrow {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 32px; height: 32px; border-radius: 50%; border: none;
  background: rgba(255,255,255,0.92); display: flex; align-items: center;
  justify-content: center; cursor: pointer; z-index: 3; opacity: 0;
  transition: opacity 0.2s ease, background 0.2s ease; color: #111;
  box-shadow: 0 2px 8px rgba(0,0,0,0.14); backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
.xy-img-slider:hover .xy-img-arrow { opacity: 1; }
.xy-img-arrow--prev { left: 8px; }
.xy-img-arrow--next { right: 8px; }
.xy-img-arrow:hover { background: #fff; transform: translateY(-50%) scale(1.08); }
@media (max-width: 767px) {
  .xy-img-arrow { opacity: 1; width: 26px; height: 26px; }
  .xy-img-arrow--prev { left: 5px; }
  .xy-img-arrow--next { right: 5px; }
  .xy-img-arrow:hover { transform: translateY(-50%) scale(1); }
}

/* ─── DOTS ─── */
.xy-img-dots {
  position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 5px; z-index: 3;
}
.xy-dot {
  width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.5);
  border: none; cursor: pointer; padding: 0;
  transition: background 0.2s ease, width 0.2s ease, border-radius 0.2s ease;
}
.xy-dot.is-active { background: #fff; width: 16px; border-radius: 4px; }
@media (max-width: 767px) {
  .xy-dot { width: 8px; height: 8px; padding: 4px; box-sizing: content-box; }
  .xy-dot.is-active { width: 18px; }
}

/* ─── DISCOUNT BADGE ─── */
.xy-badge {
  position: absolute; top: 10px; left: 10px; background: #008000;
  color: #fff; font-size: 11px; font-weight: 700; padding: 4px 9px;
  border-radius: 6px; z-index: 3; letter-spacing: 0.3px;
}
@media (max-width: 767px) { .xy-badge { font-size: 10px; padding: 3px 7px; } }

/* ─── TITLE ─── */
.xy-title {
  font-size: 15px; font-weight: 700; line-height: 1.45; margin: 0 0 8px;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
  overflow: hidden; min-height: 0.9em;
}
.xy-title a { color: #111; text-decoration: none; }
.xy-title a:hover { text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 767px) {
  .xy-title { font-size: 13px; margin: 0 0 3px; line-height:unset; }
}

/* ─── TAGS ─── */
.xy-tag-scroll {
  display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
  -ms-overflow-style: none; margin: 0 0 10px; padding-bottom: 2px; touch-action: pan-x;
}
.xy-tag-scroll::-webkit-scrollbar { display: none; }
.xy-tag-item {
  flex: 0 0 auto; padding: 4px 10px; border: 1px solid #e0e0e0;
  border-radius: 999px; background: #f6f8f3; font-size: 11px;
  font-weight: 500; color: #333; line-height: 1.4; white-space: nowrap;
}
@media (max-width: 767px) { .xy-tag-item { font-size: 10px; padding: 3px 8px; } }

/* ─── REVIEWS ─── */
.xy-review { min-height: 20px; margin-bottom: 6px; display: flex; align-items: center; }

/* ─── PRICE ─── */
.xy-price-wrap {
  display: flex; align-items: baseline; flex-wrap: wrap;
  gap: 6px; margin-bottom: 10px; margin-top: auto;
}
.xy-price   { font-size: 22px; font-weight: 700; color: #111; }
.xy-compare { font-size: 14px; color: #999; text-decoration: line-through; }
@media (max-width: 767px) {
  .xy-price   { font-size: 15px; }
  .xy-compare { font-size: 12px; }
  .xy-price-wrap { margin-bottom: 8px; gap: 4px; }
}

/* ─── BUTTONS ─── */
.xy-btn-wrap { display: flex; gap: 8px; width: 100%; }
.xy-btn-wrap .xy-cart-form,
.xy-btn-wrap .xy-buy-form  { flex: 1; margin: 0; }
.xy-cart-form .button,
.xy-cart-form .button-secondary,
.xy-buy-btn {
  width: 100%; height: 46px; min-height: 46px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  padding: 0 14px; font-size: 14px; font-weight: 600; box-sizing: border-box;
  transition: all 0.22s ease; cursor: pointer; letter-spacing: 0.2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.xy-cart-form .button,
.xy-cart-form .button-secondary { border: 1.5px solid #111; background: #fff; color: #111; }
.xy-cart-form .button:hover,
.xy-cart-form .button-secondary:hover { background: #111; color: #fff; }
.xy-buy-btn { border: none; background: #111; color: #fff; }
.xy-buy-btn:hover { background: #2a2a2a; }
.xy-cart-form .button.loading,
.xy-cart-form .button-secondary.loading { opacity: 0.6; pointer-events: none; }
.xy-cart-form .button:disabled,
.xy-cart-form .button-secondary:disabled,
.xy-buy-btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  pointer-events: none;
  background: #f5f5f5 !important;
  color: #a0a0a0 !important;
  border-color: #d8d8d8 !important;
}
@media (max-width: 767px) {
  .xy-btn-wrap { gap: 6px; flex-wrap: wrap; }
  .xy-cart-form .button,
  .xy-cart-form .button-secondary,
  .xy-buy-btn { height: 38px; min-height: 38px; font-size: 11px; padding: 0 8px; letter-spacing: 0; }
}
@media (max-width: 360px) {
  .xy-btn-wrap { flex-direction: column; gap: 5px; }
  .xy-cart-form .button,
  .xy-cart-form .button-secondary,
  .xy-buy-btn { height: 38px; min-height: 38px; font-size: 13px; padding: 0 14px; }
}

/* ─── SWIPER NAV ARROWS ─── */
.xy-nav-btn {
  position: absolute; top: calc(50% - 18px); transform: translateY(-50%);
  width: 44px; height: 44px; border-radius: 50%; background: #fff;
  border: 1px solid #e0e0e0; display: flex; align-items: center;
  justify-content: center; cursor: pointer; z-index: 10;
  transition: all 0.22s ease; color: #111; box-shadow: 0 2px 12px rgba(0,0,0,0.10);
}
.xy-nav-btn--prev { left: 4px; }
.xy-nav-btn--next { right: 4px; }
.xy-nav-btn:hover { background: #111; color: #fff; border-color: #111; box-shadow: 0 4px 16px rgba(0,0,0,0.18); }
.xy-nav-btn.swiper-button-disabled { opacity: 0; pointer-events: none; }
@media (max-width: 767px) { .xy-nav-btn { display: none; } }

/* ─── PAGINATION ─── */
.xy-pagination-{{ section.id }} {
  bottom: 0 !important; display: flex; justify-content: center;
  align-items: center; gap: 6px;
}
.xy-pagination-{{ section.id }} .swiper-pagination-bullet {
  width: 7px; height: 7px; background: #ccc; opacity: 1;
  border-radius: 50%; transition: background 0.2s ease, width 0.2s ease, border-radius 0.2s ease;
}
.xy-pagination-{{ section.id }} .swiper-pagination-bullet-active {
  background: #111; width: 20px; border-radius: 4px;
}
@media (max-width: 767px) {
  .xy-pagination-{{ section.id }} .swiper-pagination-bullet { width: 8px; height: 8px; margin: 0 3px; }
}

</style>


<!-- ░░░░░░░░░  SCRIPT  ░░░░░░░░░ -->
<script>
(function () {

  var SEC = "{{ section.id }}";

  function qs(sel, ctx)  { return (ctx || document).querySelector(sel); }
  function qsa(sel, ctx) { return (ctx || document).querySelectorAll(sel); }

  /* ══════════════════════════════════════
     GRID / SLIDER LAYOUT DETECTION
  ══════════════════════════════════════ */
  function getLayout() {
    var swiperEl = document.getElementById("xy-swiper-" + SEC);
    if (!swiperEl) return { mobile: "slider", tablet: "slider", desktop: "slider" };
    return {
      mobile : swiperEl.dataset.mobileLayout  || "slider",
      tablet : swiperEl.dataset.tabletLayout  || "slider",
      desktop: swiperEl.dataset.desktopLayout || "slider"
    };
  }

  function getCurrentBreakpoint() {
    var w = window.innerWidth;
    if (w < 768)  return "mobile";
    if (w < 1024) return "tablet";
    return "desktop";
  }

  function isGridMode() {
    var layouts = getLayout();
    var bp      = getCurrentBreakpoint();
    return layouts[bp] === "grid";
  }

  /* ══════════════════════════════════════
     INNER IMAGE SLIDER
     iPhone-safe touch handling:
     - touchstart disables outer Swiper immediately
     - touchmove detects direction; vertical restores Swiper
     - touchend always restores Swiper + snaps image
  ══════════════════════════════════════ */
  function initImgSlider(sliderEl, swiperInst) {
    var track = qs(".xy-img-track", sliderEl);
    var items = qsa(".xy-img-item", sliderEl);
    var dots  = qsa(".xy-dot",      sliderEl);
    var prev  = qs(".xy-img-arrow--prev", sliderEl);
    var next  = qs(".xy-img-arrow--next", sliderEl);

    if (!track || items.length <= 1) return;

    var current   = 0;
    var total     = items.length;
    var threshold = 45;

    function goTo(idx) {
      idx = ((idx % total) + total) % total;
      current = idx;
      track.style.transition = "transform 0.38s cubic-bezier(0.4,0,0.2,1)";
      track.style.transform  = "translateX(-" + (current * 100) + "%)";
      dots.forEach(function (d, i) { d.classList.toggle("is-active", i === current); });
    }

    function dragTo(offsetPx) {
      track.style.transition = "none";
      track.style.transform  = "translateX(calc(-" + (current * 100) + "% + " + offsetPx + "px))";
    }

    function settle(totalDx) {
      if      (totalDx < -threshold) goTo(current + 1);
      else if (totalDx >  threshold) goTo(current - 1);
      else                            goTo(current);
    }

    /* Arrow / dot buttons */
    if (prev) prev.addEventListener("click", function (e) { e.stopPropagation(); goTo(current - 1); });
    if (next) next.addEventListener("click", function (e) { e.stopPropagation(); goTo(current + 1); });
    dots.forEach(function (dot, i) {
      dot.addEventListener("click", function (e) { e.stopPropagation(); goTo(i); });
    });

    /* ── DESKTOP MOUSE ── */
    var mStartX = 0, mDragging = false, mMoved = false;

    sliderEl.addEventListener("mousedown", function (e) {
      if (e.button !== 0) return;
      mStartX   = e.clientX;
      mDragging = true;
      mMoved    = false;
      if (swiperInst) swiperInst.allowTouchMove = false;
    });

    window.addEventListener("mousemove", function (e) {
      if (!mDragging) return;
      var dx = e.clientX - mStartX;
      if (Math.abs(dx) > 5) { mMoved = true; dragTo(dx); }
    });

    window.addEventListener("mouseup", function (e) {
      if (!mDragging) return;
      mDragging = false;
      if (swiperInst) swiperInst.allowTouchMove = true;
      if (!mMoved) return;
      settle(e.clientX - mStartX);
      mMoved = false;
    });

    sliderEl.addEventListener("click", function (e) {
      if (mMoved) { e.preventDefault(); e.stopPropagation(); mMoved = false; }
    }, true);

    /* ── MOBILE TOUCH ── */
    var tStartX = 0, tStartY = 0, tActive = false, tDecided = false;

    sliderEl.addEventListener("touchstart", function (e) {
      var t   = e.touches[0];
      tStartX = t.clientX;
      tStartY = t.clientY;
      tActive = false; tDecided = false;
      /* Disable outer Swiper; restore if vertical swipe detected */
      if (swiperInst) swiperInst.allowTouchMove = false;
    }, { passive: true });

    sliderEl.addEventListener("touchmove", function (e) {
      if (!e.touches.length) return;
      var dx = e.touches[0].clientX - tStartX;
      var dy = e.touches[0].clientY - tStartY;

      if (!tDecided) {
        if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
        tDecided = true;
        if (Math.abs(dx) >= Math.abs(dy)) {
          tActive = true;   /* horizontal — we handle */
        } else {
          tActive = false;
          if (swiperInst) swiperInst.allowTouchMove = true; /* vertical — give back to Swiper */
          goTo(current);
          return;
        }
      }

      if (!tActive) return;
      dragTo(dx);
    }, { passive: true });

    function onTouchEnd(e) {
      if (swiperInst) swiperInst.allowTouchMove = true;
      if (!tActive) return;
      var finalDx = (e.changedTouches && e.changedTouches[0])
                    ? e.changedTouches[0].clientX - tStartX : 0;
      settle(finalDx);
      tActive = false; tDecided = false;
    }

    sliderEl.addEventListener("touchend",    onTouchEnd, { passive: true });
    sliderEl.addEventListener("touchcancel", onTouchEnd, { passive: true });
  }

  /* ══════════════════════════════════════
     APPLY GRID MODE
  ══════════════════════════════════════ */
  function applyGridMode(swiperEl) {
    var mobileCols  = parseInt(swiperEl.dataset.mobileCols,  10) || 2;
    var tabletCols  = parseInt(swiperEl.dataset.tabletCols,  10) || 3;
    var desktopCols = parseInt(swiperEl.dataset.desktopCols, 10) || 4;

    swiperEl.classList.add("xy-grid-mode", "xy-ready");
    swiperEl.style.setProperty("--xy-grid-cols-mobile",  mobileCols);
    swiperEl.style.setProperty("--xy-grid-cols-tablet",  tabletCols);
    swiperEl.style.setProperty("--xy-grid-cols-desktop", desktopCols);

    var bp  = getCurrentBreakpoint();
    var cur = bp === "mobile" ? mobileCols : bp === "tablet" ? tabletCols : desktopCols;
    swiperEl.style.setProperty("--xy-grid-cols", cur);

    var skeleton = document.getElementById("xy-skeleton-" + SEC);
    if (skeleton) skeleton.classList.add("is-hidden");

    qsa("[data-xy-img-slider]", swiperEl).forEach(function (el) { initImgSlider(el, null); });
    xyInitJudgeme();
  }

  /* ══════════════════════════════════════
     MAIN SWIPER INIT
  ══════════════════════════════════════ */
  function initMainSwiper() {
    var skeleton = document.getElementById("xy-skeleton-" + SEC);
    var swiperEl = document.getElementById("xy-swiper-"   + SEC);
    if (!swiperEl) return;

    if (isGridMode()) {
      applyGridMode(swiperEl);
      window.addEventListener("resize", function () {
        var bp  = getCurrentBreakpoint();
        var mob = parseInt(swiperEl.dataset.mobileCols,  10) || 2;
        var tab = parseInt(swiperEl.dataset.tabletCols,  10) || 3;
        var dsk = parseInt(swiperEl.dataset.desktopCols, 10) || 4;
        var cur = bp === "mobile" ? mob : bp === "tablet" ? tab : dsk;
        swiperEl.style.setProperty("--xy-grid-cols", cur);
      });
      return;
    }

    var isHomePage = {% if template == 'index' or template.name == 'index' or request.page_type == 'index' %}true{% else %}false{% endif %};
    var options = {
      slidesPerView  : 1.15,
      spaceBetween   : 14,
      loop           : false,
      speed          : 580,
      grabCursor     : true,
      watchOverflow  : true,
      touchRatio     : 1,
      touchAngle     : 45,
      threshold      : 10,
      resistanceRatio: 0.65,
      centeredSlides : false,
      slidesOffsetAfter: 60,

      pagination: {
        el            : ".xy-pagination-" + SEC,
        clickable     : true,
        dynamicBullets: true
      },
      navigation: {
        prevEl: "#xyPrev-" + SEC,
        nextEl: "#xyNext-" + SEC
      },
      breakpoints: {
        0:    { slidesPerView: 1.15, spaceBetween: 8 },
        480:  { slidesPerView: 1.3,  spaceBetween: 12 },
        768:  { slidesPerView: 2.2,  spaceBetween: 14 },
        1024: { slidesPerView: 3,    spaceBetween: 16 },
        1440: { slidesPerView: 4,    spaceBetween: 18 }
      }
    };

    var swiper;
    if (isHomePage) {
      swiper = new CustomSlider(".xySwiper-" + SEC, options);
    } else {
      swiper = new Swiper(".xySwiper-" + SEC, options);
    }

    requestAnimationFrame(function () {
      if (skeleton) skeleton.classList.add("is-hidden");
      swiperEl.classList.add("xy-ready");
      qsa("[data-xy-img-slider]", swiperEl).forEach(function (el) {
        initImgSlider(el, swiper);
      });
      xyInitJudgeme();
    });

    return swiper;
  }

  /* ══════════════════════════════════════
     GOKWIK CHECKOUT REDIRECT
     Uses the GoKwik SDK (window.gokwikSdk) when present on the
     storefront so Buy Now hands off to the GoKwik one-click / RTO
     checkout flow instead of the default Shopify /checkout.
     Falls back to the normal Shopify checkout if GoKwik isn't
     installed/loaded, so this section still works on stores
     without the GoKwik script.
  ══════════════════════════════════════ */
  function xyGoToCheckout() {
    try {
      if (window.gokwikSdk && typeof window.gokwikSdk.initCheckout === "function") {
        window.gokwikSdk.initCheckout();
        return;
      }
    } catch (err) {
      console.error("GoKwik checkout error, falling back to Shopify checkout:", err);
    }
    window.location.href = "/checkout";
  }

  /* ══════════════════════════════════════
     BUY NOW
  ══════════════════════════════════════ */
  document.addEventListener("submit", function (e) {
    var form = e.target.closest(".xy-buy-form");
    if (!form) return;
    e.preventDefault();
    var id  = form.querySelector("input[name='id']").value;
    var btn = form.querySelector("button");
    if (!id) return;
    if (btn) { btn.disabled = true; btn.textContent = "…"; }
    fetch("/cart/add.js", {
      method : "POST",
      headers: { "Content-Type": "application/json" },
      body   : JSON.stringify({ id: parseInt(id, 10), quantity: 1 })
    })
    .then(function () { xyGoToCheckout(); })
    .catch(function (err) {
      console.error("Buy Now error:", err);
      if (btn) { btn.disabled = false; btn.textContent = "{{ section.settings.buy_text | escape }}"; }
    });
  });

  /* ══════════════════════════════════════
     AJAX ADD TO CART
  ══════════════════════════════════════ */
  document.addEventListener("submit", function (e) {
    var form = e.target.closest(".xy-cart-form");
    if (!form || form.dataset.sectionId !== SEC) return;
    e.preventDefault();
    var variantId = form.querySelector("input[name='id']").value;
    var btn       = form.querySelector("button[type='submit']");
    if (!variantId) return;
    if (btn) { btn.disabled = true; btn.classList.add("loading"); }
    fetch("/cart/add.js", {
      method : "POST",
      headers: { "Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest" },
      body   : JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
    })
    .then(function (r) { if (!r.ok) throw new Error("Add failed"); return r.json(); })
    .then(function ()  { return fetch("/cart.js"); })
    .then(function (r) { return r.json(); })
    .then(function (cart) {
      qsa("[data-cart-count],[data-item-count],.cart-count,.cart__count,.header__cart-count,.cart-count-bubble span")
        .forEach(function (el) { el.textContent = cart.item_count; });
      document.dispatchEvent(new CustomEvent("cart:updated", { bubbles: true, detail: { cart: cart } }));
      import("@theme/events").then(function (m) {
        if (m.CartUpdateEvent) {
          document.dispatchEvent(new m.CartUpdateEvent(cart, "manual-trigger", { itemCount: cart.item_count, sections: {} }));
        }
      }).catch(function () {});
      xyOpenCartDrawer();
    })
    .catch(function (err) { console.error("Cart error:", err); })
    .finally(function () {
      setTimeout(function () {
        if (btn) { btn.disabled = false; btn.classList.remove("loading"); }
      }, 500);
    });
  });

  /* ══════════════════════════════════════
     OPEN CART DRAWER
  ══════════════════════════════════════ */
  function xyOpenCartDrawer() {
    if (typeof window.openGokwikSideCart === "function") {
      window.openGokwikSideCart(); return;
    }
    var drawer = document.querySelector("cart-drawer") ||
                 document.querySelector("cart-drawer-component");
    if (drawer) {
      if (typeof drawer.open === "function") { drawer.open(); return; }
      drawer.setAttribute("open", ""); drawer.removeAttribute("inert"); return;
    }
    var note = document.querySelector("cart-notification");
    if (note && typeof note.open === "function") { note.open(); return; }
    ["cart:open","cart:toggle","open-cart","theme:cart:open"].forEach(function (name) {
      document.dispatchEvent(new CustomEvent(name, { bubbles: true }));
    });
    var trigger = document.querySelector(
      "[data-cart-trigger],[data-open-cart],.header__cart,.cart-icon-bubble"
    );
    if (trigger) trigger.click();
  }

  /* ══════════════════════════════════════
     JUDGE.ME
  ══════════════════════════════════════ */
  function xyInitJudgeme() {
    if (window.jdgm) { try { jdgm.init(document, window.jdgm_config || {}); } catch(e){} return; }
    var tries = 0;
    var t = setInterval(function () {
      if (window.jdgm) { try { jdgm.init(document, window.jdgm_config || {}); } catch(e){} clearInterval(t); }
      if (++tries > 30) clearInterval(t);
    }, 300);
  }

  /* ══════════════════════════════════════
     BOOT
  ══════════════════════════════════════ */
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainSwiper);
  } else {
    initMainSwiper();
  }

})();
</script>

