      ],
      "default": "slider",
      "info": "Choose how products display on tablet screens"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "🖥 Desktop Layout",
      "options": [
        { "value": "slider", "label": "Slider (Swipe)" },
        { "value": "grid",   "label": "Grid" }
      ],
      "default": "slider",
