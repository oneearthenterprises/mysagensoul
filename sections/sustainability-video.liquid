<section class="sustainability-video-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    
    <!-- Centered Heading & Subheading -->
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="video-section-header text-center">
        {% if section.settings.heading != blank %}
          <h2 class="video-main-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <p class="video-sub-desc">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Video Player Container (No Play Button Overlay) -->
    <div class="video-player-outer-wrap" style="max-width: {{ section.settings.video_max_width }}px;">
      <div class="video-player-inner">
        
        {% if section.settings.video != blank %}
          <!-- Native Shopify Video Tag (Autoplays based on settings, no custom overlays) -->
          {{ section.settings.video | video_tag: 
            class: 'sustainability-video', 
            image_size: '1400x', 
            autoplay: section.settings.autoplay, 
            loop: section.settings.loop, 
            muted: true, 
            controls: section.settings.show_controls, 
            playsinline: true 
          }}

        {% elsif section.settings.external_video_url != blank %}
          <!-- External Video Embed (YouTube / Vimeo) -->
          {% if section.settings.external_video_url contains 'youtube.com' or section.settings.external_video_url contains 'youtu.be' %}
            {% assign video_id = section.settings.external_video_url | split: 'v=' | last | split: '&' | first %}
            {% if section.settings.external_video_url contains 'youtu.be/' %}
              {% assign video_id = section.settings.external_video_url | split: 'youtu.be/' | last | split: '?' | first %}
            {% endif %}
            
            <iframe 
              class="sustainability-video-iframe"
              src="https://www.youtube.com/embed/{{ video_id }}?autoplay={% if section.settings.autoplay %}1{% else %}0{% endif %}&mute={% if section.settings.autoplay %}1{% else %}0{% endif %}&loop={% if section.settings.loop %}1{% else %}0{% endif %}&playlist={{ video_id }}&controls={% if section.settings.show_controls %}1{% else %}0{% endif %}&rel=0" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
            ></iframe>
          
          {% elsif section.settings.external_video_url contains 'vimeo.com' %}
            {% assign video_id = section.settings.external_video_url | split: 'vimeo.com/' | last | split: '?' | first %}
            
            <iframe 
              class="sustainability-video-iframe"
              src="https://player.vimeo.com/video/{{ video_id }}?autoplay={% if section.settings.autoplay %}1{% else %}0{% endif %}&muted={% if section.settings.autoplay %}1{% else %}0{% endif %}&loop={% if section.settings.loop %}1{% else %}0{% endif %}&controls={% if section.settings.show_controls %}1{% else %}0{% endif %}" 
              frameborder="0" 
              allow="autoplay; fullscreen; picture-in-picture" 
              allowfullscreen
            ></iframe>
          {% endif %}
          
        {% else %}
          <!-- Placeholder visual when no video is uploaded -->
          <div class="video-placeholder-box">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 9L15 12L10 15V9Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
            <span>Select a Video or enter an External Video link in Customizer settings</span>
          </div>
        {% endif %}

      </div>
    </div>

  </div>
</section>

<style>
.sustainability-video-section {
  overflow: hidden;
  font-family: var(--font-body--family), sans-serif;
}

.sustainability-video-section .page-width {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 20px;
}

.video-section-header {
  max-width: 780px;
  margin: 0 auto 45px auto;
}

.video-main-heading {
  font-size: clamp(26px, 3.5vw, 42px);
  font-weight: 600;
  line-height: 1.25;
  color: #1a1a1a;
  margin: 0 0 16px 0;
  letter-spacing: -0.6px;
}

/* Green highlight styling for tags like <span> or custom highlight class */
.video-main-heading span,
.video-main-heading strong {
  color: #4f7a55; /* Sustainability Accent Green */
  font-weight: inherit;
}

.video-sub-desc {
  font-size: 15px;
  line-height: 1.6;
  color: #666666;
  margin: 0;
}

/* Video Player wrapping container styling */
.video-player-outer-wrap {
  margin: 0 auto;
  width: 100%;
}

.video-player-inner {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
  height: 0;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.05);
  background-color: #000000;
}

.sustainability-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border: none;
  display: block;
}

.sustainability-video-iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

/* Placeholder card when no URL */
.video-placeholder-box {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #f4f6f3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8c9b7d;
  gap: 15px;
  font-size: 14px;
}

.video-placeholder-box svg {
  width: 52px;
  height: 52px;
}

/* Responsive Overrides */
@media (max-width: 767px) {
  .sustainability-video-section {
    padding-left: 15px;
    padding-right: 15px;
  }
  .video-player-inner {
    border-radius: 16px;
  }
  .video-section-header {
    margin-bottom: 30px;
  }
}
</style>

{% schema %}
{
  "name": "Sustainability Video",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Text Headers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quantifying Greenhouse Gas Removals and Reductions in <span>Real-Time</span>",
      "info": "Tip: Use <span>your text</span> to make it green."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Paragraph",
      "default": "Hyphen empowers your projects with precision real-time GHG quantification, helping you seamlessly deliver high-quality carbon credits to market faster."
    },
    {
      "type": "header",
      "content": "Video Files & Controls"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Select Video (Shopify Files)"
    },
    {
      "type": "text",
      "id": "external_video_url",
      "label": "Or External Video (YouTube / Vimeo Link)",
      "info": "YouTube or Vimeo links (e.g. https://www.youtube.com/watch?v=xxxxxx)"
    },
    {
      "type": "range",
      "id": "video_max_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Video Max Width",
      "default": 1200
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (muted)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop Video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show Video Controls",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Sustainability Video"
    }
  ]
}
{% endschema %}
