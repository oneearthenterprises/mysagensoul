{% assign word_count = article.content | strip_html | split: ' ' | size %}
{% assign read_time = word_count | divided_by: 200 %}
{% if read_time < 1 %}{% assign read_time = 1 %}{% endif %}

{% assign primary_tag = article.tags.first %}
{% assign share_url = shop.url | append: article.url %}

<div class="custom-blog">

  <!-- BREADCRUMB -->
  <div class="cba-breadcrumb">
    <a href="/">Home</a>
    <span>&rsaquo;</span>
    <a href="{{ blog.url }}">Blogs</a>
    {% if primary_tag %}
      <span>&rsaquo;</span>
      <a href="{{ blog.url }}/tagged/{{ primary_tag | handleize }}">{{ primary_tag }}</a>
    {% endif %}
    <span>&rsaquo;</span>
    <span class="cba-breadcrumb-current">{{ article.title }}</span>
  </div>

  <!-- HEADER -->
  <div class="cba-header">
    {% if primary_tag %}
      <span class="cba-badge">{{ primary_tag }}</span>
    {% endif %}

    <h1 class="cba-title">{{ article.title }}</h1>

    <div class="cba-meta-row">
      <div class="cba-author-block">
        {% assign author_image = article.metafields.custom.author_image %}
        {% if author_image %}
          <img src="{{ author_image | image_url: width: 60 }}" alt="{{ article.author }}" class="cba-author-avatar">
        {% else %}
          <span class="cba-author-avatar cba-author-initial">{{ article.author | slice: 0 }}</span>
        {% endif %}
        <span class="cba-author-name">BY {{ article.author | upcase }}</span>
        <span class="cba-dot">|</span>
        <span class="cba-date">{{ article.published_at | date: "%B %d, %Y" }}</span>
        <span class="cba-dot">|</span>
        <span class="cba-read-time">{{ read_time }} min read</span>
      </div>

      <div class="cba-share-row">
        <span class="cba-share-label">Share</span>
       <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}"
   target="_blank"
   rel="noopener"
   class="cba-share-btn"
   aria-label="Share on Facebook">
          F
</a>
        <a href="https://www.tumblr.com/widgets/share/tool?canonicalUrl={{ share_url | url_encode }}" target="_blank" rel="noopener" class="cba-share-btn" aria-label="Share on Tumblr">t</a>
        <a href="https://t.me/share/url?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" class="cba-share-btn" aria-label="Share on Telegram">tg</a>
        <a href="mailto:?subject={{ article.title | url_encode }}&body={{ share_url | url_encode }}" class="cba-share-btn" aria-label="Share via Email">@</a>
      </div>
    </div>
  </div>

  <!-- MAIN LAYOUT -->
  <div class="blog-layout">

    <!-- LEFT CONTENT -->
    <div class="blog-main">

      <!-- Sticky share icons (desktop only) -->
      <div class="cba-sticky-share">
        <span class="cba-share-label-vertical">Share</span>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" class="cba-share-circle" aria-label="Share on Facebook">f</a>
        <a href="https://www.tumblr.com/widgets/share/tool?canonicalUrl={{ share_url | url_encode }}" target="_blank" rel="noopener" class="cba-share-circle" aria-label="Share on Tumblr">t</a>
      <a href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}"
   target="_blank"
   rel="noopener"
   class="cba-share-circle"
   aria-label="Share on X (Twitter)">
                x

</a>
        <a href="mailto:?subject={{ article.title | url_encode }}&body={{ share_url | url_encode }}" class="cba-share-circle" aria-label="Share via Email">@</a>
      </div>

      {% if article.image %}
        <div class="cba-hero">
          <img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.title }}" class="cba-hero-img">
        </div>
      {% endif %}

      <!-- IN THIS ARTICLE (auto table of contents) -->
      <div class="cba-toc" id="cba-toc" style="display:none;">
        <h3>In This Article</h3>
        <ul id="cba-toc-list"></ul>
      </div>

      <div class="section custom-content" id="cba-article-content">
        {{ article.content }}
      </div>
    </div>

    <!-- RIGHT SIDEBAR -->
    <div class="blog-sidebar">

      <!-- Most Read -->
      <div class="sidebar-box">
        <h3 class="cba-sidebar-title">{{ section.settings.mostread_heading }}</h3>

        {% assign mr_blog = blogs[section.settings.blog_handle] %}
        {% assign mostread_articles = mr_blog.articles %}
        {% if section.settings.mostread_tag != blank %}
          {% assign tagged = mr_blog.articles | where: "tags", section.settings.mostread_tag %}
          {% if tagged.size > 0 %}
            {% assign mostread_articles = tagged %}
          {% endif %}
        {% endif %}

        {% for recent_article in mostread_articles limit: section.settings.mostread_limit %}
          <a href="{{ recent_article.url }}" class="sidebar-link">
            <div class="sidebar-item">
              {% if recent_article.image %}
                <img src="{{ recent_article.image | image_url: width: 120 }}" alt="{{ recent_article.title }}" />
              {% endif %}
              <div>
                <span class="cba-mr-date">{{ recent_article.published_at | date: "%B %d, %Y" }}</span>
                <p>{{ recent_article.title }}</p>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>

            <!-- Recommended Products -->
     <div class="sidebar-box">
        <h3 class="cba-sidebar-title">{{ section.settings.products_heading }}</h3>

        {% assign rec_products = article.metafields.custom.recommended_products.value %}
        {% for product in rec_products %}
          {% if product != blank %}
            <a href="{{ product.url }}" class="sidebar-link">
              <div class="sidebar-item">

                <!-- PRODUCT IMAGE -->
                <div class="sidebar-img-wrap">
                  <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title }}" />
                </div>

                <!-- PRODUCT INFO -->
                <div>
                  <p class="sidebar-product-title">{{ product.title }}</p>

                  <div class="sidebar-price-wrap">
                    <span class="price-sale">{{ product.price | money }}</span>

                    {% if product.compare_at_price > product.price %}
                      {% assign discount = product.compare_at_price | minus: product.price %}
                      {% assign percent_off = discount | times: 100 | divided_by: product.compare_at_price %}
                      <span class="price-original">{{ product.compare_at_price | money }}</span>
                      <span class="badge-off">{{ percent_off }}% OFF</span>
                    {% endif %}
                  </div>
                </div>

              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Stay In Touch -->
      <div class="sidebar-box">
        <h3 class="cba-sidebar-title">{{ section.settings.social_heading }}</h3>
        <div class="cba-social-grid">
          {% if section.settings.facebook_url != blank %}
