<script>
  document.addEventListener('DOMContentLoaded', function () {
    var content = document.getElementById('cba-article-content');
    var toc = document.getElementById('cba-toc');
    var list = document.getElementById('cba-toc-list');
    if (!content || !toc || !list) return;

    var headings = content.querySelectorAll('h2, h3');
    if (headings.length === 0) return;

    headings.forEach(function (heading, index) {
      var slug = heading.textContent.trim().toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '') || ('section-' + index);
      heading.id = slug;

      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + slug;
      a.textContent = heading.textContent;
      if (heading.tagName.toLowerCase() === 'h3') {
        li.className = 'cba-toc-sub';
      }
      li.appendChild(a);
      list.appendChild(li);
    });

    toc.style.display = 'block';
  });
</script>

<style>

/* ===== BREADCRUMB ===== */
.cba-breadcrumb {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px 20px 0;
  font-size: 13px;
  color: #999;
}

.cba-breadcrumb a {
  color: #999;
  text-decoration: none;
}

.cba-breadcrumb a:hover {
  color: #1a1a1a;
}

.cba-breadcrumb span {
  margin: 0 6px;
}

.cba-breadcrumb-current {
  color: #1a1a1a;
  font-weight: 600;
}

/* ===== HEADER ===== */
.cba-header {
  max-width: 1200px;
  margin: 0 auto;
  padding: 16px 20px 24px;
}

.cba-badge {
  display: inline-block;
  background: var(--cba-accent, #e8a33d);
  color: #1a1a1a;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 3px;
  margin-bottom: 16px;
}

.cba-title {
  font-size: 34px;
  line-height: 1.3;
  margin: 0 0 18px;
  color: #1a1a1a;
}

.cba-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}

.cba-author-block {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #555;
}

.cba-author-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  object-fit: cover;
}

.cba-author-initial {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--cba-accent, #e8a33d);
  color: #1a1a1a;
  font-weight: 700;
  font-size: 13px;
}

.cba-author-name {
  font-weight: 700;
  color: #1a1a1a;
}

.cba-dot {
  opacity: 0.5;
}

.cba-share-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cba-share-label {
  font-size: 13px;
  color: #555;
  margin-right: 4px;
}

.cba-share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #f2f2f2;
  color: #1a1a1a;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
}

.cba-share-btn:hover {
  background: var(--cba-accent, #e8a33d);
}

/* ===== STICKY SHARE (left rail) ===== */
.cba-sticky-share {
  position: sticky;
  top: 120px;
  float: left;
  margin-left: -70px;
  display: flex;
