{% schema %}
{
  "name": "User Guide",
  "tag": "section",
  "class": "section user-guide-section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#e7dfd1"
    }
  ],
  "presets": [
    {
      "name": "User Guidesss"
    }
  ]
}
{% endschema %}

{% assign item = product.metafields.custom.user_guide.value %}

{% if item != blank %}

<div class="user-guide-wrap">
  <div class="page-width">

    <h2 class="user-guide-heading">How to Brew the Perfect Cup</h2>

    <div class="user-guide-grid">

      <!-- LEFT IMAGE -->
      <div class="user-guide-left">
        {% if item.image != blank %}
          <img
            src="{{ item.image | image_url: width: 1200 }}"
            alt="{{ item.title }}"
            loading="lazy">
        {% endif %}
      </div>

      <!-- RIGHT CONTENT -->
      <div class="user-guide-right">

        <!-- HOW TO USE -->
        <div class="guide-box">
          <div class="guidebox-padding">

            {% if item.title != blank %}
              <h3>{{ item.title }}</h3>
            {% endif %}

        

            {% if item.how_to_use != blank %}
              <ul class="how-to-list">
                {% for step in item.how_to_use.value %}
                  
                  {% assign icon = step.how_to_use_icon | default: step.value.how_to_use_icon %}
                  {% assign text = step.how_to_use_text | default: step.value.how_to_use_text %}

                  {% if icon != blank or text != blank %}
                    <li>
                      {% if icon != blank %}
                        <img src="{{ icon | image_url: width: 60 }}" alt="">
                      {% endif %}
                      <span>{{ text }}</span>
                    </li>
                  {% endif %}

                {% endfor %}
              </ul>
            {% endif %}

          </div>
        </div>

        <!-- WHEN TO USE -->
        <div class="guide-box">
          <div class="guidebox-padding">

            {% if item.second_title != blank %}
              <h4>{{ item.second_title }}</h4>
            {% endif %}

            {% if item.second_descripation != blank %}
              <div class="guide-readmore">
                <p class="guide-text">
                  {{ item.second_descripation }}
                </p>
                <button class="read-more-btn" type="button">
                  Read More
                </button>
              </div>
            {% endif %}

          </div>
        </div>
  <!-- CHEF SECRET -->
  <div class="chef-secret">
      <div class="chef-icon">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <!-- Group applying global styles for the strokes -->
  <g fill="none" stroke="#000000" stroke-width="18" stroke-linecap="round" stroke-linejoin="round">
    
    <!-- Left outer puff -->
    <path d="M 160 260 C 90 260 90 140 160 160" />
    
    <!-- Top-left puff -->
    <path d="M 150 170 C 140 60 250 60 260 140" />
    
    <!-- Top-right puff -->
    <path d="M 240 140 C 260 40 380 60 370 170" />
    
    <!-- Right outer puff -->
    <path d="M 360 160 C 430 140 430 260 360 260" />
    
    <!-- Left vertical base line -->
    <path d="M 155 255 Q 145 340 120 420" />
    
    <!-- Right vertical base line -->
    <path d="M 365 255 Q 375 340 380 400" />
    
    <!-- Upper bottom swoosh -->
    <path d="M 200 365 Q 300 360 380 400" />
    
    <!-- Lower bottom swoosh -->
    <path d="M 120 420 Q 250 380 300 420" />
    
  </g>
</svg>
 </div>

    <h3>The Chef’s Secret</h3>

    {% if item.descripation != blank %}
      <p class="guide-desc">{{ item.descripation }}</p>
    {% endif %}
  </div>
      </div>
       

    </div>

  </div>
</div>

{% endif %}

<style>

.chef-icon{
  display:flex;
  justify-content:start;
  margin-bottom:10px;
}
.chef-icon svg {
    width: 70px;
    height: 70px;
    position: absolute;
    padding: 10px;
    top: -28px;
    left: -25px;
    rotate: -19deg;
      transition: transform 0.3s ease;
}
.chef-icon svg:hover{
  transform: scale(1.15);
}
.chef-secret h3{
  margin:0 0 12px;
  font-size:22px;
  text-transform:uppercase;
  letter-spacing:1px;
  font-weight:700;
  text-align:left;
}
.guide-box{
  backdrop-filter: blur(6px);
}

.user-guide-section{
  background: {{ section.settings.bg }};
}

.user-guide-wrap{
  padding: 80px 0;
}

.user-guide-heading{
  text-align: center;
  font-size: 48px;
  font-weight: 600;
  margin-bottom: 50px;
}

/* GRID */
.user-guide-grid{
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
  align-items: center;
}

/* IMAGE */
.user-guide-left{
  overflow: hidden;
  border-radius: 20px;
}

.user-guide-left img{
  width: 100%;
  height: 420px;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.user-guide-left:hover img{
  transform: scale(1.08);
}

/* RIGHT SIDE */
.user-guide-right{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;;
}

.chef-secret{
  grid-column:1 / -1;
  background:#ede1d799;
  border-radius:16px;
  padding:20px;
  text-align:center;
  position: relative;
}

.chef-secret h3{
  font-size:22px;
  margin-bottom:15px;
  text-transform:uppercase;
  letter-spacing:1px;
  font-weight:700;
}

.chef-secret .guide-desc{
  margin:0;
  font-size:16px;
  line-height:1.7;
}

/* BOX */
.guidebox-padding{
  padding: 20px;
}

.guide-box{
  background: #ffffff;
  border-radius: 16px;
  transition: all 0.35s ease;
}

.guide-box:hover{
  transform: translateY(-8px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.08);
}

/* HEADINGS */
.guide-box h3,
.guide-box h4{
  font-size: 22px;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 700;
}

/* DESCRIPTION */
.guide-desc{
  font-size: 14px !important;
  color: #000;
  margin-bottom: 15px;
  text-align: left;
}

/* LIST */
.how-to-list{
  list-style: none;
  padding: 0;
  margin: 0;
}

.how-to-list li{
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
  font-size: 16px;
}

.how-to-list img{
  width: 32px;
  height: 32px;
  object-fit: contain;
}

/* TEXT */
.guide-box p{
  font-size: 16px;
  line-height: 1.5;
}

/* READ MORE */
.guide-readmore{
  position: relative;
}

.guide-text {
  max-height: 170px;        /* collapsed height — adjust to match ~6 lines */
  overflow: hidden;
  transition: max-height 0.5s ease;
}

.guide-readmore.active .guide-text {
  max-height: 1000px;       /* large enough to fit any content */
}

.read-more-btn {
  margin-top: 12px;
  background: transparent;
  border: none;
  color: #000;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: gap 0.2s ease;
}
.read-more-btn::after {
  content: '↓';
  display: inline-block;
  transition: transform 0.4s ease;
  font-size: 13px;
} 
.guide-readmore.active .read-more-btn::after {
  transform: rotate(180deg);   /* arrow flips to ↑ when expanded */
} 
/* TABLET */
@media(max-width:1024px){
  .user-guide-heading{
    font-size: 36px;
  }

  .user-guide-grid{
    grid-template-columns: 1fr;
  }

  .user-guide-right{
    grid-template-columns: 1fr 1fr;
  }
}

/* MOBILE */
@media(max-width:768px){

  .user-guide-wrap{
    padding: 40px 0;
  }

  .user-guide-heading{
    font-size: 26px;
    margin-bottom: 25px;
    padding: 0 10px;
  }

  .user-guide-grid{
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .user-guide-left img{
    height: 220px;
    border-radius: 14px;
  }

  .user-guide-right{
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .guide-box{
    border-radius: 12px;
  }

  .guidebox-padding{
    padding: 18px;
  }

  .guide-box h3,
  .guide-box h4{
    font-size: 18px;
  }

  .guide-desc,
  .guide-box p{
    font-size: 14px;
  }

  .how-to-list li{
    font-size: 14px;
  }

  .how-to-list img{
    width: 26px;
    height: 26px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const buttons = document.querySelectorAll(".read-more-btn");

  buttons.forEach(button => {
    button.addEventListener("click", function () {
      const wrapper = this.closest(".guide-readmore");
      wrapper.classList.toggle("active");

      this.textContent = wrapper.classList.contains("active")
        ? "Read Less"
        : "Read More";
    });
  });
});
</script>