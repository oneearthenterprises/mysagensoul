<section class="privacy-policy-page">
  <div class="privacy-wrapper">

    {% if section.settings.heading != blank %}
      <h1 class="privacy-title">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="privacy-subtitle">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="privacy-content rte">
      {{ page.content }}
    </div>

  </div>
</section>

<style>
.privacy-policy-page{
  background:#EEF1EA;
  padding:80px 20px;
}

.privacy-wrapper{
  max-width:900px;
  margin:0 auto;
  width:100%;
}

.privacy-title{
  font-size:clamp(32px,5vw,54px);
  font-weight:700;
  line-height:1.2;
  text-align:center;
  color:#111;
  margin-bottom:14px;
}

.privacy-subtitle{
  font-size:clamp(15px,2vw,20px);
  line-height:1.6;
  text-align:center;
  color:#555;
  max-width:800px;
  margin:0 auto 50px;
}

.privacy-content{
  font-size:clamp(15px,1.4vw,18px);
  line-height:1.9;
  color:#222;
}

.privacy-content h2, .privacy-content h3, .privacy-content h4 {
    font-size: clamp(22px,3vw,26px);
    line-height: 1.3;
    font-weight: 700;
    margin-top: 14px;
    margin-bottom: 8px;
    color: #111;
}

.privacy-content p{
  margin-bottom:8px;
}

.privacy-content ul,
.privacy-content ol{
  padding-left:24px;
  margin-bottom:20px;
}

.privacy-content li{
  margin-bottom:10px;
}

.privacy-content a{
  color:#111;
  text-decoration:underline;
}

@media (max-width:768px){
  .privacy-policy-page{
    padding:45px 15px;
  }

  .privacy-title{
    margin-bottom:10px;
  }

  .privacy-subtitle{
    margin-bottom:30px;
  }

  .privacy-content{
    line-height:1.7;
  }

  .privacy-content h2,
  .privacy-content h3,
  .privacy-content h4{
    margin-top:28px;
    margin-bottom:12px;
  }
}
</style>

{% schema %}
{
  "name": "Privacy Policy Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Privacy Policy"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Please review our privacy practices and how we collect, use, and protect your information."
    }
  ],
  "presets": [
    {
      "name": "Privacy Policy Page"
    }
  ]
}
{% endschema %}