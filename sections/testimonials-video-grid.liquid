{% comment %}
  Testimonials Video Grid Section
{% endcomment %}

<div class="tvg-section">
  <div class="tvg-container">
    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <div class="tvg-header-row">
        <div class="tvg-header-text">
          {% if section.settings.heading != blank %}
            <h2 class="tvg-heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subtitle != blank %}
            <p class="tvg-sub">{{ section.settings.subtitle }}</p>
          {% endif %}
        </div>
        <div class="tvg-nav-buttons">
          <button type="button" class="tvg-nav-btn tvg-nav-prev" data-tvg-prev aria-label="Previous videos">&larr;</button>
          <button type="button" class="tvg-nav-btn tvg-nav-next" data-tvg-next aria-label="Next videos">&rarr;</button>
        </div>
      </div>
    {% endif %}

    <div class="tvg-grid">
      {% for block in section.blocks %}
        {% if block.settings.video != blank %}
          <div class="tvg-card" {{ block.shopify_attributes }}>
            <div class="tvg-media-wrap">
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'tvg-video' }}
              
              <button class="tvg-mute-btn" aria-label="Toggle sound">
                <svg class="icon-muted" viewBox="0 0 24 24" fill="white" width="18" height="18">
                  <path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06A8.99 8.99 0 0 0 17.73 19L19 20.27 20.27 19 5.27 4 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                </svg>
                <svg class="icon-unmuted" viewBox="0 0 24 24" fill="white" width="18" height="18" style="display:none;">
                  <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                </svg>
              </button>

              <div class="tvg-overlay"></div>
              
              <div class="tvg-info">
                <div class="tvg-rating">
                  {% for i in (1..5) %}
                    <svg viewBox="0 0 24 24" fill="#e8a33d" width="14" height="14">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  {% endfor %}
                </div>
                <h3 class="tvg-name">{{ block.settings.customer_name }}</h3>
                <span class="tvg-tag">{{ block.settings.customer_tag }}</span>
              </div>
            </div>
            {% if block.settings.review_text != blank %}
              <div class="tvg-body">
                <p>"{{ block.settings.review_text }}"</p>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
.tvg-section {
  padding: 80px 20px;
  background-color: #ffffff;
}
.tvg-container {
  max-width: 1440px;
  margin: 0 auto;
}
.tvg-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 40px;
}
.tvg-header-text {
  text-align: left;
}
.tvg-nav-buttons {
  display: flex;
  gap: 12px;
}
.tvg-nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: #fbfaf8;
  border: 1px solid #e5dfd9;
  color: #1a1a1a;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}
.tvg-nav-btn:hover {
  background-color: #1a1a1a;
  border-color: #1a1a1a;
  color: #ffffff;
}
.tvg-heading {
  font-size: 32px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 12px;
}
.tvg-sub {
  font-size: 16px;
  color: #666;
  margin: 0;
  max-width: 600px;
  margin: 0 auto;
}
.tvg-grid {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  gap: 30px;
  scrollbar-width: none;
  padding-bottom: 20px;
  scroll-behavior: smooth;
}
.tvg-grid::-webkit-scrollbar {
  display: none;
}
.tvg-card {
  flex: 0 0 calc(20% - 24px); /* Show exactly 5 items on desktop */
  scroll-snap-align: start;
  min-width: 200px;
  background: #fbfaf8;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  border: 1px solid #f0edeb;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s;
}
.tvg-card:hover {
  transform: translateY(-4px);
}
.tvg-media-wrap {
  position: relative;
  aspect-ratio: 9/16;
  background: #000;
  overflow: hidden;
}
.tvg-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.tvg-mute-btn {
  position: absolute;
  top: 15px;
  right: 15px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: background 0.3s;
}
.tvg-mute-btn:hover {
  background: rgba(0, 0, 0, 0.75);
}
.tvg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.1) 60%, rgba(0,0,0,0) 100%);
  pointer-events: none;
  z-index: 2;
}
.tvg-info {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  color: #fff;
  z-index: 3;
}
.tvg-rating {
  display: flex;
  gap: 2px;
  margin-bottom: 6px;
}
.tvg-name {
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 2px;
  color: #fff;
}
.tvg-tag {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #e8a33d;
}
.tvg-body {
  padding: 24px;
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tvg-body p {
  font-size: 15px;
  line-height: 1.5;
  color: #4a4238;
  margin: 0;
  text-align: center;
  font-style: italic;
  font-weight: 500;
}
@media (max-width: 1024px) {
  .tvg-card {
    flex: 0 0 calc(25% - 22px); /* 4 items on small desktops */
  }
}
@media (max-width: 768px) {
  .tvg-card {
    flex: 0 0 calc(33.333% - 20px); /* 3 items on tablets */
  }
  .tvg-header-row {
    margin-bottom: 30px;
  }
}
@media (max-width: 600px) {
  .tvg-card {
    flex: 0 0 calc(50% - 15px); /* 2 items on small screens */
  }
  .tvg-grid {
    gap: 15px;
  }
  .tvg-section {
    padding: 60px 15px;
  }
  .tvg-header-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .tvg-nav-buttons {
    align-self: flex-end;
  }
}
@media (max-width: 480px) {
  .tvg-card {
    flex: 0 0 65%; /* 1.5 items on mobile to encourage swiping */
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  // Slider navigation logic
  const grid = document.querySelector(".tvg-grid");
  const prevBtn = document.querySelector("[data-tvg-prev]");
  const nextBtn = document.querySelector("[data-tvg-next]");

  if (grid && prevBtn && nextBtn) {
    function scrollGrid(direction) {
      const cardWidth = grid.querySelector(".tvg-card")?.offsetWidth || 240;
      const gap = parseInt(window.getComputedStyle(grid).gap) || 20;
      const scrollAmount = (cardWidth + gap) * direction;
      grid.scrollBy({ left: scrollAmount, behavior: "smooth" });
    }

    prevBtn.addEventListener("click", () => scrollGrid(-1));
    nextBtn.addEventListener("click", () => scrollGrid(1));
  }

  // Play/mute sound logic for each video
  const cards = document.querySelectorAll(".tvg-card");
  cards.forEach(card => {
    const video = card.querySelector(".tvg-video");
    const muteBtn = card.querySelector(".tvg-mute-btn");
    if (!video) return;

    // Force play on load (safeguard for autoplay)
    video.play().catch(() => {});

    function toggleMute() {
      const iconMuted = muteBtn?.querySelector(".icon-muted");
      const iconUnmuted = muteBtn?.querySelector(".icon-unmuted");
      
      if (video.muted) {
        // We want to unmute this video, but first mute all other videos!
        cards.forEach(otherCard => {
          const otherVideo = otherCard.querySelector(".tvg-video");
          const otherMuteBtn = otherCard.querySelector(".tvg-mute-btn");
          if (otherVideo && otherVideo !== video) {
            otherVideo.muted = true;
            const otherIconMuted = otherMuteBtn?.querySelector(".icon-muted");
            const otherIconUnmuted = otherMuteBtn?.querySelector(".icon-unmuted");
            if (otherIconMuted) otherIconMuted.style.display = "block";
            if (otherIconUnmuted) otherIconUnmuted.style.display = "none";
          }
        });

        video.muted = false;
        if (iconMuted) iconMuted.style.display = "none";
        if (iconUnmuted) iconUnmuted.style.display = "block";
      } else {
        video.muted = true;
        if (iconMuted) iconMuted.style.display = "block";
        if (iconUnmuted) iconUnmuted.style.display = "none";
      }
    }

    // Clicking anywhere on the video card toggles mute/unmute
    const mediaWrap = card.querySelector(".tvg-media-wrap");
    mediaWrap?.addEventListener("click", (e) => {
      toggleMute();
    });

    // Mute button click
    muteBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMute();
    });
  });
});
</script>

{% schema %}
{
  "name": "Testimonials Video Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch Their Stories" },
    { "type": "textarea", "id": "subtitle", "label": "Subtext", "default": "Real video reviews from our community members sharing their daily tea rituals." }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Review Card",
      "settings": [
        { "type": "video", "id": "video", "label": "Review Video" },
        { "type": "text", "id": "customer_name", "label": "Customer Name", "default": "Verified Customer" },
        { "type": "text", "id": "customer_tag", "label": "Customer Tag", "default": "Verified Buyer" },
        { "type": "textarea", "id": "review_text", "label": "Review Excerpt" }
      ]
    }
  ]
}
{% endschema %}
