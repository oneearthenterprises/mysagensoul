{% comment %}
  Testimonials Video Grid Section
{% endcomment %}

<div class="tvg-section">
  <div class="tvg-container">
    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <div class="tvg-header">
        {% if section.settings.heading != blank %}
          <h2 class="tvg-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="tvg-sub">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="tvg-grid">
      {% for block in section.blocks %}
        {% if block.settings.video != blank %}
          <div class="tvg-card" {{ block.shopify_attributes }}>
            <div class="tvg-media-wrap">
              {{ block.settings.video | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, class: 'tvg-video' }}
              
              <button class="tvg-play-btn" aria-label="Play video">
                <svg viewBox="0 0 24 24" fill="white" width="30" height="30">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>

              <button class="tvg-mute-btn" aria-label="Toggle sound">
                <svg class="icon-muted" viewBox="0 0 24 24" fill="white" width="18" height="18">
                  <path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06A8.99 8.99 0 0 0 17.73 19L19 20.27 20.27 19 5.27 4 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                </svg>
                <svg class="icon-unmuted" viewBox="0 0 24 24" fill="white" width="18" height="18" style="display:none;">
                  <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                </svg>
              </button>

              <div class="tvg-overlay"></div>
              
              <div class="tvg-info">
                <div class="tvg-rating">
                  {% for i in (1..5) %}
                    <svg viewBox="0 0 24 24" fill="#e8a33d" width="14" height="14">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  {% endfor %}
                </div>
                <h3 class="tvg-name">{{ block.settings.customer_name }}</h3>
                <span class="tvg-tag">{{ block.settings.customer_tag }}</span>
              </div>
            </div>
            {% if block.settings.review_text != blank %}
              <div class="tvg-body">
                <p>"{{ block.settings.review_text }}"</p>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
.tvg-section {
  padding: 80px 20px;
  background-color: #ffffff;
}
.tvg-container {
  max-width: 1200px;
  margin: 0 auto;
}
.tvg-header {
  text-align: center;
  margin-bottom: 50px;
}
.tvg-heading {
  font-size: 32px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 12px;
}
.tvg-sub {
  font-size: 16px;
  color: #666;
  margin: 0;
  max-width: 600px;
  margin: 0 auto;
}
.tvg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}
.tvg-card {
  background: #fbfaf8;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  border: 1px solid #f0edeb;
  display: flex;
  flex-direction: column;
}
.tvg-media-wrap {
  position: relative;
  aspect-ratio: 9/16;
  background: #000;
  overflow: hidden;
}
.tvg-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.tvg-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: transform 0.3s, background 0.3s;
}
.tvg-card:hover .tvg-play-btn {
  transform: translate(-50%, -50%) scale(1.08);
  background: rgba(0, 0, 0, 0.7);
}
.tvg-mute-btn {
  position: absolute;
  top: 15px;
  right: 15px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: background 0.3s;
}
.tvg-mute-btn:hover {
  background: rgba(0, 0, 0, 0.75);
}
.tvg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.1) 60%, rgba(0,0,0,0) 100%);
  pointer-events: none;
  z-index: 2;
}
.tvg-info {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  color: #fff;
  z-index: 3;
}
.tvg-rating {
  display: flex;
  gap: 2px;
  margin-bottom: 6px;
}
.tvg-name {
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 2px;
  color: #fff;
}
.tvg-tag {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #e8a33d;
}
.tvg-body {
  padding: 24px;
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tvg-body p {
  font-size: 15px;
  line-height: 1.5;
  color: #4a4238;
  margin: 0;
  text-align: center;
  font-style: italic;
  font-weight: 500;
}
@media (max-width: 900px) {
  .tvg-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 600px) {
  .tvg-grid {
    grid-template-columns: 1fr;
  }
  .tvg-section {
    padding: 60px 15px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".tvg-card").forEach(card => {
    const video = card.querySelector(".tvg-video");
    const playBtn = card.querySelector(".tvg-play-btn");
    const muteBtn = card.querySelector(".tvg-mute-btn");
    if (!video) return;

    let isPlaying = false;

    // Toggle Play/Pause
    function togglePlay() {
      if (isPlaying) {
        video.pause();
        playBtn.style.display = "flex";
      } else {
        video.play().catch(() => {});
        playBtn.style.display = "none";
      }
      isPlaying = !isPlaying;
    }

    playBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      togglePlay();
    });

    video.addEventListener("click", () => {
      togglePlay();
    });

    // Mute/Unmute
    muteBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      video.muted = !video.muted;
      const iconMuted = muteBtn.querySelector(".icon-muted");
      const iconUnmuted = muteBtn.querySelector(".icon-unmuted");
      if (video.muted) {
        iconMuted.style.display = "block";
        iconUnmuted.style.display = "none";
      } else {
        iconMuted.style.display = "none";
        iconUnmuted.style.display = "block";
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Testimonials Video Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch Their Stories" },
    { "type": "textarea", "id": "subtitle", "label": "Subtext", "default": "Real video reviews from our community members sharing their daily tea rituals." }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Review Card",
      "settings": [
        { "type": "video", "id": "video", "label": "Review Video" },
        { "type": "text", "id": "customer_name", "label": "Customer Name", "default": "Verified Customer" },
        { "type": "text", "id": "customer_tag", "label": "Customer Tag", "default": "Verified Buyer" },
        { "type": "textarea", "id": "review_text", "label": "Review Excerpt" }
      ]
    }
  ]
}
{% endschema %}
