<section class="refund-cancel-page">
  <div class="refund-cancel-wrapper">

    {% if section.settings.heading != blank %}
      <h1 class="refund-cancel-title">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="refund-cancel-subtitle">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <div class="refund-cancel-content rte">
      {{ page.content }}
    </div>

  </div>
</section>

<style>
.refund-cancel-page{
  background:#EEF1EA;
  padding:80px 20px;
}

.refund-cancel-wrapper{
  max-width:900px;
  margin:0 auto;
  width:100%;
}

.refund-cancel-title{
  font-size:clamp(32px,5vw,54px);
  font-weight:700;
  line-height:1.2;
  text-align:center;
  color:#111;
  margin-bottom:14px;
}

.refund-cancel-subtitle{
  font-size:clamp(15px,2vw,20px);
  line-height:1.6;
  text-align:center;
  color:#555;
  max-width:800px;
  margin:0 auto 50px;
}

.refund-cancel-content{
  font-size:clamp(15px,1.4vw,16px);
  line-height:1.9;
  color:#222;
}

.refund-cancel-content h2,
.refund-cancel-content h3,
.refund-cancel-content h4{
  font-size:clamp(22px,3vw,26px);
  line-height:1.3;
  font-weight:700;
  margin-top:14px;
  margin-bottom:8px;
  color:#111;
}

.refund-cancel-content p{
  margin-bottom:8px;
}

.refund-cancel-content ul,
.refund-cancel-content ol{
  padding-left:24px;
  margin-bottom:20px;
}

.refund-cancel-content li{
  margin-bottom:10px;
}

.refund-cancel-content a{
  color:#111;
  text-decoration:underline;
}

@media(max-width:768px){

  .refund-cancel-page{
    padding:45px 15px;
  }

  .refund-cancel-title{
    margin-bottom:10px;
  }

  .refund-cancel-subtitle{
    margin-bottom:30px;
  }

  .refund-cancel-content{
    line-height:1.7;
  }

  .refund-cancel-content h2,
  .refund-cancel-content h3,
  .refund-cancel-content h4{
    margin-top:28px;
    margin-bottom:12px;
  }

}
</style>

{% schema %}
{
  "name": "Refund Cancellation Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Refunds & Cancellation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Please review our cancellation and refund policy carefully before placing your order."
    }
  ],
  "presets": [
    {
      "name": "Refund Cancellation Page"
    }
  ]
}
{% endschema %}