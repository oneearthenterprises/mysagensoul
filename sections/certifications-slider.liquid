{% schema %}
{
  "name": "Certifications Slider",
  "tag": "section",
  "class": "section certifications-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Certifications"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f8f6f2"
    }
  ],
  "presets": [
    {
      "name": "Certifications Slider"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Certification Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}

<section class="certifications-wrap">
  <div class="page-width">

    <h2 class="certifications-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="cert-slider-main">

      <div class="cert-arrow cert-prev">&#10094;</div>

      <div class="swiper certSlider">
        <div class="swiper-wrapper">

      {% for i in (1..3) %}
  {% for block in section.blocks %}
  <div class="swiper-slide" {{ block.shopify_attributes }}>
    <div class="cert-card">

      {% if block.settings.icon != blank %}
      <img
        src="{{ block.settings.icon | image_url: width: 300 }}"
        alt="{{ block.settings.title }}"
        loading="lazy" width="" height=" ">
      {% endif %}

      {% if block.settings.title != blank %}
      {% comment %} <h3>{{ block.settings.title }}</h3> {% endcomment %}
      {% endif %}

    </div>
  </div>
  {% endfor %}
{% endfor %}
        </div>
      </div>

      <div class="cert-arrow cert-next">&#10095;</div>

    </div>

  </div>
</section>

<style>
.certifications-section{
  background:{{ section.settings.bg }};
}

.certifications-wrap {
    padding: 45px 0px 70px 30px;
}

.certifications-heading{
  text-align:center;
  font-size:42px;
  margin:0 0 35px;
  font-weight:700;
}

.cert-slider-main{
  display:flex;
  align-items:center;
  gap:0px;
}

.certSlider{
  flex:1;
  overflow:hidden;
}

.cert-card{
  {% comment %} background:#fff; {% endcomment %}
  border-radius:16px;
  {% comment %} padding:25px; {% endcomment %}
  text-align:center;
  {% comment %} box-shadow:0 6px 20px rgba(0,0,0,.06); {% endcomment %}
}

.cert-card img{
  width:105px;
  height:105px;
  object-fit:contain;
  margin:auto;
}

.cert-card h3{
  font-size:16px;
  margin:14px 0 0;
}

.cert-arrow{
  width:42px;
  height:42px;
  border-radius:50%;
  background:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  box-shadow:0 5px 15px rgba(0,0,0,.08);
}

@media(max-width:768px){

.certifications-wrap{
  padding:30px 0;
}

.certifications-heading{
  font-size:30px;
}

.cert-card{
  padding:18px;
}

.cert-card img{
  width:70px;
  height:70px;
}

.cert-arrow{
  display: none !important;
}

}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var isHomePage = {% if template == 'index' or template.name == 'index' or request.page_type == 'index' %}true{% else %}false{% endif %};
  var options = {
    autoplay: {
      delay: 2500,
      disableOnInteraction: false
    },
    navigation: {
      nextEl: ".cert-prev",
      prevEl: ".cert-next"
    },
    slidesPerView: 2,
    spaceBetween: 15,
    breakpoints: {
      480: { slidesPerView: 2 },
      768: { slidesPerView: 4 }
    }
  };
  new Swiper(".certSlider", options);
});
</script>