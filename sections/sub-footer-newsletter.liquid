{% comment %}
  Sub Footer Newsletter (Premium Design)
{% endcomment %}

<div class="sub-footer-newsletter">



  <div class="newsletter-inner">

    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>

   {% form 'customer' %}
  <div class="newsletter-form">
    
    <input type="hidden" name="contact[tags]" value="newsletter">

    <div class="input-wrap">
      <input 
        type="email"
        name="contact[email]"
        placeholder="Your email address"
        required
      >
      <span class="mail-icon">✉</span>
    </div>

    <button type="submit">SUBSCRIBE</button>

  </div>

  {% if form.posted_successfully? %}
    <p class="success-msg">Thanks for subscribing!</p>
  {% endif %}

{% endform %}

  </div>
</div>

<style>
.sub-footer-newsletter {
  position: relative;
  text-align: center;
  padding: 100px 20px;
  background: #f5f7f3;
  overflow: hidden;
}

/* BACKGROUND PATTERN */
.sub-footer-newsletter::before {
  content: "";
  position: absolute;
  inset: 0;
  background: url('https://www.transparenttextures.com/patterns/leaf.png');
  opacity: 0.08;
}

/* SIDE IMAGES */
.leaf-left {
  position: absolute;
  left: 0;
  top: 20%;
  width: 120px;
}

.leaf-right {
  position: absolute;
  right: 0;
  top: 10%;
  width: 160px;
}

/* CONTENT */
.newsletter-inner {
  position: relative;
  max-width: 750px;
  margin: auto;
}

/* HEADING */
.newsletter-inner h2 {
  font-size: 48px;
  font-weight: 700;
  color: #1b5e3c;
  margin-bottom: 10px;
}

/* TEXT */
.newsletter-inner p {
  font-size: 16px;
  color: #555;
  margin-bottom: 30px;
}

/* FORM */
.newsletter-form {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

/* INPUT WRAP */
.input-wrap {
  position: relative;
  background: #fff;
  border-radius: 50px;
  padding: 5px 15px;
  display: flex;
  align-items: center;
  width: 400px;
}

/* INPUT */
.input-wrap input {
  border: none;
  outline: none;
  width: 100%;
  padding: 14px;
  font-size: 14px;
}

/* ICON */
.mail-icon {
  position: absolute;
  right: 15px;
  color: #1b5e3c;
}

/* BUTTON */
.newsletter-form button {
  background: #8bc34a;
  color: #fff;
  border: none;
  padding: 14px 30px;
  border-radius: 30px;
  font-weight: 600;
  cursor: pointer;
}

.newsletter-form button:hover {
  background: #689f38;
}

/* SUCCESS MESSAGE FIX */
.success-msg {
  margin-top: 12px;
  text-align: center;
  color: green;
  width: 100%;
}
/* MOBILE */
@media(max-width:768px){
  .newsletter-inner h2 {
    font-size: 28px;
  }

  .newsletter-form {
    flex-direction: column;
  }

  .input-wrap {
    width: 100%;
  }

  .leaf-left,
  .leaf-right {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Sub Footer Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let’s Stay Connected"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Sub Text",
      "default": "Sign up for 10% off and be the first to know about new products, offers, and all the tea."
    },
 
 
  ],
  "presets": [
    {
      "name": "Sub Footer Newsletter"
    }
  ]
}
{% endschema %}