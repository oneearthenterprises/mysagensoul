{% schema %}
{
  "name": "Soul Of Blend Metafield",
  "tag": "section",
  "class": "section soul-meta-section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Soul Of Blend Metafield"
    }
  ]
}
{% endschema %}

<section class="soul-meta-wrap" style="background:{{ section.settings.bg }};">
  <div class="page-width">
    {% assign heading = product.metafields.custom.soul_blend_heading.value %}
    {% assign titles = product.metafields.custom.soul_blend_titles.value %}
    {% assign descs = product.metafields.custom.soul_blend_descriptions.value %}
    {% assign images = product.metafields.custom.soul_blend_images221.value %}

    {% if heading != blank %}
      <h2 class="soul-meta-heading">{{ heading }}</h2>
    {% endif %}

    <div class="soul-meta-grid">
      {% for item in titles %}
        {% assign i = forloop.index0 %}
        {% assign desc = descs[i] %}
        {% assign img_file = images[i] %}

        <div class="soul-meta-item">
          <div class="soul-meta-image">

          
            <p style="color:red;font-size:11px;word-break:break-all;">
              raw: {{ img_file }}<br>
              src: {{ img_file.src }}<br>
              json: {{ img_file | json }}
            </p>

            {% if img_file != blank %}
              {% if img_file.src %}
                <img
                  src="{{ img_file | image_url: width: 300 }}"
                  alt="{{ item }}"
                  class="blend-img"
                  loading="lazy"
                  width="180"
                  height="180">
              {% elsif img_file contains 'http' %}
                <img
                  src="{{ img_file }}"
                  alt="{{ item }}"
                  class="blend-img"
                  loading="lazy"
                  width="180"
                  height="180">
              {% else %}
                <img
                  src="{{ img_file | file_url }}"
                  alt="{{ item }}"
                  class="blend-img"
                  loading="lazy"
                  width="180"
                  height="180">
              {% endif %}
            {% endif %}

          </div>
          <h3>{{ item }}</h3>
          {% if desc != blank %}
            <p>{{ desc }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.soul-meta-wrap { padding: 80px 0; }
.soul-meta-heading {
  text-align: center;
  font-size: 44px;
  font-weight: 700;
  color: #111;
  margin: 0 0 60px;
}
.soul-meta-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 30px;
}
.soul-meta-item { text-align: center; }
.soul-meta-image {
  border-top: 1px solid #d8d8d8;
  border-bottom: 1px solid #d8d8d8;
  min-height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  margin-bottom: 22px;
}
.blend-img {
  max-width: 140px;
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
  margin: auto;
}
.soul-meta-item h3 {
  font-size: 26px;
  font-weight: 700;
  color: #111;
  margin: 0 0 12px;
}
.soul-meta-item p {
  margin: 0;
  font-size: 18px;
  line-height: 1.5;
  color: #555;
}
@media (max-width: 1100px) {
  .soul-meta-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 768px) {
  .soul-meta-wrap { padding: 55px 0; }
  .soul-meta-heading { font-size: 32px; margin-bottom: 35px; }
  .soul-meta-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .soul-meta-item h3 { font-size: 20px; }
  .soul-meta-item p { font-size: 15px; }
  .soul-meta-image { min-height: 150px; padding: 16px; }
  .blend-img { max-width: 110px; }
}
@media (max-width: 480px) {
  .soul-meta-grid { grid-template-columns: 1fr; }
}
</style>
