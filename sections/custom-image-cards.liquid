<div class="custom-cards-section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="custom-cards-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="custom-cards-wrapper">
      <div class="custom-cards-track">

        {% for block in section.blocks %}
          <div class="custom-card" {{ block.shopify_attributes }}>
            <div class="card-inner">
              {% if block.settings.image %}
                {% if block.settings.card_link != blank %}
                  <a href="{{ block.settings.card_link }}">
                {% endif %}

                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >

                {% if block.settings.card_link != blank %}
                  </a>
                {% endif %}
              {% endif %}

              {% if block.settings.button_text != blank %}
                <div class="card-button-wrap">
                  {% if block.settings.card_link != blank %}
                    <a href="{{ block.settings.card_link }}" class="card-btn">
                      {{ block.settings.button_text }}
                    </a>
                  {% else %}
                    <span class="card-btn">{{ block.settings.button_text }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</div>

<style>
.custom-cards-section {
  padding: 50px 0;
  background: #fdfbf9;
}

.custom-cards-section .page-width {
  max-width: 1440px !important;
  margin: 0 auto;
  padding: 0 20px;
}

.custom-cards-wrapper {
  width: 100%;
  position: relative;
}

.custom-cards-track {
  display: flex;
  gap: 20px;
}

.custom-card {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  flex-shrink: 0;
  border-radius: 12px;
  overflow: hidden;
}

.card-inner {
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
  height: 100%;
  border: 1px solid #eae5df;
  border-radius: 12px;
}

.card-inner a {
  display: block;
  overflow: hidden;
}

.card-inner img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.5s ease;
}

/* Zoom effect on image hover */
.custom-card:hover img {
  transform: scale(1.05);
}

.custom-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(30, 77, 58, 0.08);
}

/* Bottom button styling */
.card-button-wrap {
  text-align: center;
  padding: 20px 15px;
  background: #fff;
  margin-top: auto;
}

.card-btn {
  display: inline-block;
  width: 100%;
  padding: 12px 24px;
  background: #000000;
  color: #ffffff;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
  cursor: pointer;
  border: 1px solid #000000;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.card-btn:hover {
  background: transparent;
  color: #000000;
  border-color: #000000;
  letter-spacing: 1.5px;
}

/* Mobile: horizontal scroll with snap */
@media (max-width: 767px) {
  .custom-cards-section {
    padding: 25px 0;
  }

  .custom-cards-track {
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0px;
    gap: 15px;
  }

  .custom-cards-track::-webkit-scrollbar {
    display: none;
  }

  .custom-card {
    width: 80%;
    scroll-snap-align: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.04);
  }

  .custom-card:hover {
    transform: none;
    box-shadow: 0 4px 10px rgba(0,0,0,0.04);
  }
}

/* Desktop grid layout */
@media (min-width: 768px) {
  .custom-cards-track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .custom-card {
    width: 100%;
  }
}

.custom-cards-heading {
  text-align: center;
  margin-bottom: 35px;
}

.custom-cards-heading h2 {
  font-size: clamp(24px, 3.5vw, 36px);
  font-weight: 700;
  line-height: 1.3;
  margin: 0;
  color: #000000cf;
  text-transform: uppercase;
  letter-spacing: 1px;
}

@media (max-width: 767px) {
  .custom-cards-heading {
    margin-bottom: 20px;
    padding: 0 20px;
  }
}
</style>

{% schema %}
{
  "name": "Custom Image Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Sage & Soul"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image Cards"
    }
  ]
}
{% endschema %}