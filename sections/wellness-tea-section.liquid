<section class="tea-section page-width section">
  <div class="tea-wrapper">
    <img class="img222l" src="https://cdn.shopify.com/s/files/1/0741/6958/1722/files/h1_decor-1.png?v=1776338233" alt="tea0" width="50" height="50">
    <img class="img222r" src="https://cdn.shopify.com/s/files/1/0741/6958/1722/files/h1_decor-2.png?v=1776338233" alt="tea0" width="50" height="50">

    <!-- LEFT IMAGE -->
    <div class="tea-image">
      <img src="{{ section.settings.image | image_url }}" width="400" height="400" alt="Tea">
    </div>

    <!-- RIGHT CONTENT -->
    <div class="tea-content">
      <h2>{{ section.settings.heading }}</h2>
      <p class="tea-desc">{{ section.settings.description }}</p>

      <div class="tea-features">
        <div class="tea-feature">
          <img src="{{ section.settings.icon1 | image_url }}" width="40" height="40" alt="icon">
          <div>
            <h4>{{ section.settings.feature1_title }}</h4>
            <p>{{ section.settings.feature1_text }}</p>
          </div>
        </div>

        <div class="tea-feature">
          <img src="{{ section.settings.icon2 | image_url }}" width="40" height="40" alt="icon">
          <div>
            <h4>{{ section.settings.feature2_title }}</h4>
            <p>{{ section.settings.feature2_text }}</p>
          </div>
        </div>
      </div>

      <a href="{{ section.settings.button_link }}" class="tea-btn">
        {{ section.settings.button_text }}
      </a>
    </div>

  </div>
</section>

<style>
img.img222l {
    position: absolute;
    width: 87px;
    left: 0;
    top: 48px;
    animation: floatX 4s ease-in-out infinite;
}

img.img222r {
    position: absolute;
    right: 0;
    width: 100px;
    bottom: 50px;
    animation: floatX 5s ease-in-out infinite;
}

@keyframes floatX {
    0% { transform: translateX(0px); }
    50% { transform: translateX(10px); }
    100% { transform: translateX(0px); }
}

.tea-section {
  padding: 40px 0;
  overflow: hidden;
}

.tea-wrapper {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #f5f5f5;
  border-radius: 10px;
  overflow: hidden;
}

.tea-feature img {
  width: 50px;
  height: 50px;
}

.tea-image {
  flex: 1;
  background: #1e4d3a;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tea-image img {
  max-width: 100%;
  height: 500px !important;
  object-fit: cover;
}

.tea-content {
  flex: 1;
  padding: 40px;
}

.tea-content h2 {
  font-size: 36px;
  color: #1e4d3a;
  margin-bottom: 15px;
}

.tea-desc {
  color: #555;
  margin-bottom: 25px;
}

.tea-features {
  display: grid;
    grid-template-columns: repeat(2, 1fr); /* 3 equal columns */
  gap: 30px;
  margin-bottom: 25px;
}

@media only screen and (max-width: 767px) {
    .tea-features {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    .tea-content h2 {
    font-size: 26px;
    color: #1e4d3a;
    margin-bottom: 15px;
}
}


.tea-feature .icon {
  font-size: 24px;
}

.tea-feature h4 {
  margin: 0;
  font-size: 16px;
}

.tea-feature p {
  font-size: 13px;
  margin-top: 8px;
}

.tea-btn {
  display: inline-block;
  padding: 12px 20px;
  border: 1px solid #1e4d3a;
  color: #1e4d3a;
  text-decoration: none;
  border-radius: 6px;
  transition: 0.3s;
}

.tea-btn:hover {
  background: #1e4d3a;
  color: #fff;
}

/* MOBILE */
@media (max-width: 768px) {
  .tea-wrapper {
    gap: 0px;
  }
  .tea-section {
    padding: 20px 0;
  }
  .tea-wrapper {
    flex-direction: column;
  }
  .tea-content {
    padding: 10px;
  }
  .tea-image img {
    max-width: 100%;
    height: 100% !important;
    object-fit: contain;
  }
}
</style>

{% schema %}
{
  "name": "Wellness Tea Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Tea Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wellness & Artisan Teas"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand blended herbs & premium teas for body, mind & spirit."
    },
    {
      "type": "image_picker",
      "id": "icon1",
      "label": "Feature Icon 1"
    },
    {
      "type": "text",
      "id": "feature1_title",
      "label": "Feature 1 Title",
      "default": "Detox"
    },
    {
      "type": "text",
      "id": "feature1_text",
      "label": "Feature 1 Description",
      "default": "Supports natural body cleansing"
    },
    {
      "type": "image_picker",
      "id": "icon2",
      "label": "Feature Icon 2"
    },
    {
      "type": "text",
      "id": "feature2_title",
      "label": "Feature 2 Title",
      "default": "Lose Weight"
    },
    {
      "type": "text",
      "id": "feature2_text",
      "label": "Feature 2 Description",
      "default": "Helps maintain healthy weight"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop The Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Wellness Tea Section"
    }
  ]
}
{% endschema %}