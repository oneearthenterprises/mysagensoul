<section id="testimonials-section-{{ section.id }}" class="testimonials-card-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    
    <!-- Testimonial Section Header with Navigation Arrows -->
    {% if section.settings.title != blank or section.settings.description != blank %}
      <div class="testimonials-header-row">
        <div class="testimonials-header-left">
          {% if section.settings.title != blank %}
            <h2 class="testimonials-section-title">{{ section.settings.title }}</h2>
          {% endif %}
        </div>
        <div class="testimonials-header-right">
          {% if section.settings.description != blank %}
            <p class="testimonials-section-desc">{{ section.settings.description }}</p>
          {% endif %}
          
          <!-- Slider Navigation Arrows -->
          <div class="slider-arrows">
            <button class="slider-arrow prev-btn" aria-label="Previous Slide">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
            </button>
            <button class="slider-arrow next-btn" aria-label="Next Slide">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- Slider Track of Testimonial Cards -->
    <div class="testimonials-slider-track">
      {% for block in section.blocks %}
        <div class="testimonial-grid-card" {{ block.shopify_attributes }}>
          
          <!-- Background image of the card -->
          <div class="testimonial-card-bg-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.author | escape }}" loading="lazy">
            {% else %}
              <!-- Fallback background gradient when no image is uploaded -->
              <div class="testimonial-placeholder-bg"></div>
            {% endif %}
          </div>

          <!-- Bottom dark gradient overlay -->
          <div class="testimonial-card-overlay"></div>

          <!-- Testimonial content -->
          <div class="testimonial-card-content">
            {% if block.settings.quote != blank %}
              <p class="testimonial-quote">"{{ block.settings.quote }}"</p>
            {% endif %}
            
            {% if block.settings.author != blank %}
              <h4 class="testimonial-author">{{ block.settings.author }}</h4>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

<script>
  function initTestimonialSlider(sectionId) {
    const container = document.getElementById('testimonials-section-' + sectionId);
    if (!container) return;
    const track = container.querySelector(".testimonials-slider-track");
    const prevBtn = container.querySelector(".prev-btn");
    const nextBtn = container.querySelector(".next-btn");
    
    if (!track || !prevBtn || !nextBtn) return;

    const getScrollAmount = () => {
      const card = track.querySelector(".testimonial-grid-card");
      if (!card) return track.clientWidth;
      return card.clientWidth + 20; // card width + gap
    };

    prevBtn.addEventListener("click", () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      track.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    initTestimonialSlider("{{ section.id }}");
  });

  // Re-initialize inside Shopify Theme Editor live preview when edited
  document.addEventListener("shopify:section:load", function (e) {
    if (e.detail.sectionId === "{{ section.id }}") {
      initTestimonialSlider("{{ section.id }}");
    }
  });
</script>

<style>
.testimonials-card-section {
  overflow: visible;
  font-family: var(--font-body--family), sans-serif;
}

.testimonials-card-section .page-width {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header Split Row Styling */
.testimonials-header-row {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 60px;
  align-items: center;
  margin-bottom: 55px;
}

.testimonials-section-title {
  font-size: clamp(28px, 4.5vw, 46px);
  font-weight: 700;
  line-height: 1.15;
  color: #1a1a1a;
  margin: 0;
  letter-spacing: -1px;
}

.testimonials-header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 30px;
}

.testimonials-section-desc {
  font-size: 16px;
  line-height: 1.6;
  color: #4a4a4a;
  margin: 0;
  max-width: 420px;
}

/* Slider Arrows */
.slider-arrows {
  display: flex;
  gap: 12px;
  flex-shrink: 0;
}

.slider-arrow {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 1.5px solid rgba(0, 0, 0, 0.1);
  background-color: #ffffff;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  padding: 0;
}

.slider-arrow:hover {
  background-color: #1a1a1a;
  color: #ffffff;
  border-color: #1a1a1a;
}

.slider-arrow svg {
  width: 18px;
  height: 18px;
}

/* Slider Track container */
.testimonials-slider-track {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none; /* Hide scrollbar Firefox */
  -ms-overflow-style: none;  /* Hide scrollbar IE/Edge */
  padding-bottom: 10px;
  user-select: none;
}

.testimonials-slider-track::-webkit-scrollbar {
  display: none; /* Hide scrollbar Chrome/Safari */
}

/* Testimonial Card container */
.testimonial-grid-card {
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  height: 480px;
  display: flex;
  align-items: flex-end;
  padding: 35px 28px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  flex: 0 0 calc(25% - 15px); /* 4 cards in viewport */
  scroll-snap-align: start;
}

.testimonial-grid-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
}

/* Background image wrap & img styles */
.testimonial-card-bg-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  overflow: hidden;
  background-color: #e5e8e3;
}

.testimonial-card-bg-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.testimonial-grid-card:hover .testimonial-card-bg-wrap img {
  transform: scale(1.04);
}

.testimonial-placeholder-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #8c9b7d 0%, #4f7a55 100%);
  opacity: 0.2;
}

/* Dark gradient overlay */
.testimonial-card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.45) 45%, rgba(0, 0, 0, 0) 100%);
  transition: opacity 0.3s ease;
}

/* Testimonial text & author layout */
.testimonial-card-content {
  position: relative;
  z-index: 3;
  width: 100%;
  text-align: center;
  color: #ffffff;
}

.testimonial-quote {
  font-size: 13.5px;
  line-height: 1.55;
  margin: 0 0 16px 0;
  opacity: 0.9;
  font-weight: 400;
  letter-spacing: 0.1px;
}

.testimonial-author {
  font-size: 15px;
  font-weight: 600;
  margin: 0;
  color: #ffffff;
  letter-spacing: 0.3px;
}

/* Responsive styles */
@media (max-width: 1199px) {
  .testimonials-header-row {
    gap: 40px;
  }
  .testimonial-grid-card {
    flex: 0 0 calc(50% - 10px); /* 2 cards in viewport */
    height: 440px;
  }
}

@media (max-width: 767px) {
  .testimonials-card-section {
    padding-left: 15px;
    padding-right: 15px;
  }
  
  .testimonials-header-row {
    grid-template-columns: 1fr;
    gap: 15px;
    text-align: center;
    margin-bottom: 35px;
  }

  .testimonials-header-right {
    flex-direction: column;
    align-items: center;
    gap: 20px;
    justify-content: center;
  }

  .testimonials-section-desc {
    text-align: center;
    max-width: 100%;
  }

  .testimonial-grid-card {
    flex: 0 0 100%; /* 1 card in viewport */
    height: 400px;
    padding: 30px 20px;
  }
}
</style>

