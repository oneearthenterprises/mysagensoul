<section class="counter-custom section">
  <div class="page-width">
    <div class="counter-wrapper">

      <div class="counter-heading">
        {{ section.settings.heading }}
      </div>

      <div class="countdown">
        <div class="time-box">
          <span id="days">02</span>
          <small>DAYS</small>
        </div>

        <div class="divider"></div>

        <div class="time-box">
          <span id="hours">05</span>
          <small>HOURS</small>
        </div>

        <div class="divider"></div>

        <div class="time-box">
          <span id="minutes">36</span>
          <small>MINUTES</small>
        </div>

        <div class="divider"></div>

        <div class="time-box">
          <span id="seconds">42</span>
          <small>SECONDS</small>
        </div>
      </div>

      <a href="{{ section.settings.button_link }}" class="shop-btn">
        {{ section.settings.button_text }}
      </a>

    </div>
  </div>
</section>

<style>
.counter-custom{
  background:#f3f3f3 !important;
  padding:40px 0;
}

.counter-wrapper{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:40px;
  flex-wrap:wrap;
  max-width:1440px;
  margin:0 auto;
}

.counter-heading{
  font-size:42px;
  font-weight:700;
  color:#000;
  line-height:1.2;
}

.countdown{
  display:flex;
  align-items:center;
  gap:20px;
}

.time-box{
  text-align:center;
  min-width:70px;
}

.time-box span{
  display:block;
  font-size:42px;
  font-weight:700;
  color:#000;
  line-height:1;
}

.time-box small{
  font-size:12px;
  letter-spacing:2px;
  text-transform:uppercase;
  color:#000;
}

.divider{
  width:1px;
  height:50px;
  background:#000;
}

.shop-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:#9cb4c0;
  color:#fff;
  text-decoration:none;
  padding:16px 40px;
  font-size:16px;
  font-weight:700;
  letter-spacing:3px;
  text-transform:uppercase;
  transition:.3s;
}

.shop-btn:hover{
  opacity:.9;
}


@media(max-width:1024px){
  .counter-heading {
    font-size: 27px;
 
}
@media(max-width:991px){

  .counter-wrapper{
    flex-direction:column;
    text-align:center;
  }

  .counter-heading{
    font-size:32px;
  }

  .time-box span{
    font-size:32px;
  }
}
@media(max-width:767px){


.countdown{

  gap:0px;
}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const THREE_DAYS = 3 * 24 * 60 * 60 * 1000;

  let start = localStorage.getItem("counterCustomStart");

  if (!start) {
    start = Date.now();
    localStorage.setItem("counterCustomStart", start);
  }

  start = parseInt(start);

  function updateTimer() {

    let now = Date.now();
    let end = start + THREE_DAYS;

    if (now >= end) {
      start = now;
      localStorage.setItem("counterCustomStart", start);
      end = start + THREE_DAYS;
    }

    const distance = end - now;

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    document.getElementById("days").innerHTML = String(days).padStart(2,'0');
    document.getElementById("hours").innerHTML = String(hours).padStart(2,'0');
    document.getElementById("minutes").innerHTML = String(minutes).padStart(2,'0');
    document.getElementById("seconds").innerHTML = String(seconds).padStart(2,'0');
  }

  updateTimer();
  setInterval(updateTimer,1000);
});
</script>

{% schema %}
{
  "name": "Counter Custom",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Payday Sale ends in:"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW!"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Counter Custom"
    }
  ]
}
{% endschema %}