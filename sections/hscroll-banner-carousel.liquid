<section class="hscroll-banner-carousel">

  <div class="swiper hscrollSwiper">

    <div class="swiper-wrapper">

      {% for block in section.blocks %}

        <div class="swiper-slide">

          <a
            href="{{ block.settings.banner_link }}"
            class="hscroll-banner-item"
          >

            <!-- DESKTOP IMAGE -->
            {% if block.settings.desktop_image != blank %}
              <img
                class="hscroll-desktop-img"
                src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
                alt="Desktop Banner"
                loading="lazy"
                width="2000"
                height="300"
              >
            {% endif %}

            <!-- MOBILE IMAGE -->
            {% if block.settings.mobile_image != blank %}
              <img
                class="hscroll-mobile-img"
                src="{{ block.settings.mobile_image | image_url: width: 900 }}"
                alt="Mobile Banner"
                loading="lazy"
                width="900"
                height="300"
              >
            {% endif %}

          </a>

        </div>

      {% endfor %}

    </div>

    <!-- PAGINATION -->
    <div class="hscroll-pagination"></div>

  </div>

</section>

<style>

.hscroll-banner-carousel{
 

  overflow:hidden;
  position:relative;
}

/* SWIPER */

.hscrollSwiper{
  width:100%;
  height:clamp(220px, 31vw, 650px);
  overflow:hidden;
}

/* SLIDE */

.hscroll-banner-item{
  display:block;
  width:100%;

  overflow:hidden;
  -webkit-user-drag:none;
}

/* IMAGE — full image shown, no cropping */

.hscroll-banner-item img{
  width:100%;
  height:100% !important;
  object-fit:cover;
  display:block;
  pointer-events:none;
  -webkit-user-drag:none;
  user-select:none;
}

/* MOBILE IMAGE HIDE */

.hscroll-mobile-img{
  display:none !important;
}

/* PAGINATION */

.hscroll-banner-carousel .hscroll-pagination{
  position:absolute;
  right:24px !important;
  left:auto !important;
  top:50% !important;
  transform:translateY(-50%);
  width:auto !important;
  display:flex !important;
  flex-direction:column;
  align-items:center;
  gap:8px;
  z-index:20;
}

.hscroll-banner-carousel .hscroll-pagination .swiper-pagination-bullet{
  width:10px;
  height:10px;
  background:#fff;
  opacity:.6;
  display:block;
  margin:0 !important;
  border:1px solid rgba(0,0,0,.15);
}

.hscroll-banner-carousel .hscroll-pagination .swiper-pagination-bullet-active{
  height:30px;
  width:10px;
  border-radius:20px;
  opacity:1;
  background:#fff;
}

/* MOBILE */

@media(max-width:768px){

  .hscrollSwiper{
    height:clamp(280px, 80vw, 500px);
  }

  .hscroll-desktop-img{
    display:none !important;
  }

  .hscroll-mobile-img{
    display:block !important;
  }

}

</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var isHomePage = {% if template == 'index' or template.name == 'index' or request.page_type == 'index' %}true{% else %}false{% endif %};
  var options = {
    autoplay: {
      delay: 3000,
      disableOnInteraction: false
    },
    pagination: {
      el: ".hscroll-banner-carousel .hscroll-pagination",
      clickable: true
    },
    slidesPerView: 1,
    loop: true
  };
  if (isHomePage) {
    new CustomSlider(".hscrollSwiper", options);
  } else {
    new Swiper(".hscrollSwiper", options);
  }
});
</script>

{% schema %}
{
  "name": "HORIXANTAL SCROLL",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Banner"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Banner"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Banner Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORIXANTAL SCROLL"
    }
  ]
}
{% endschema %}
