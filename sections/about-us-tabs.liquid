<section class="about-us-tabs section">
  <div class="page-width">
    
    {% if section.settings.heading != blank %}
      <h2 class="about-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="about-grid">

      {% for block in section.blocks %}
        <div class="about-item">
          
          {% if block.settings.icon != blank %}
            <div class="about-icon">
              <img src="{{ block.settings.icon | image_url: width: 120 }}" alt="{{ block.settings.title }}">
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
.about-us-tabs{
  padding: 80px 20px;
  background: #f7f7f7;
}

.about-heading{
  text-align: center;
  font-size: 42px;
  line-height: 1.3;
  margin-bottom: 60px;
  color: #b2872b;
  font-weight: 600;
}

.about-grid{
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 40px;
  align-items: start;
}

.about-item{
  text-align: center;
}

.about-icon{
  width: 120px;
  height: 120px;
  margin: 0 auto 25px;
  border: 1px solid #bdbdbd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.about-icon img{
  width: 55px;
  height: 55px;
  object-fit: contain;
}

.about-item h3{
  font-size: 24px;
  line-height: 1.4;
  margin-bottom: 10px;
  font-weight: 700;
  color: #000;
}

.about-item p{
  font-size: 16px;
  line-height: 1.8;
  color: #222;
  max-width: 320px;
  margin: 0 auto;
}

@media screen and (max-width: 991px){

  .about-grid{
    grid-template-columns: repeat(2,1fr);
    gap: 35px;
  }

  .about-heading{
    font-size: 34px;
  }

  .about-item h3{
    font-size: 26px;
  }

  .about-item p{
    font-size: 19px;
  }
}

@media screen and (max-width: 767px){

  .about-us-tabs{
    padding: 60px 15px;
  }

  .about-grid{
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .about-heading{
    font-size: 28px;
    margin-bottom: 45px;
  }

  .about-icon{
    width: 100px;
    height: 100px;
  }

  .about-icon img{
    width: 45px;
    height: 45px;
  }

  .about-item h3{
    font-size: 22px;
  }

  .about-item p{
    font-size: 17px;
    line-height: 1.7;
  }
}
</style>

{% schema %}
{
  "name": "About Us Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grounded In Nature, Growing With Science"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "About Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Milk Is Our Signature Ingredient"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Our products are made with the goodness of Goat Milk, Rice Milk, Oat Milk, Almond Milk & Soy Milk."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Tabs",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %} 