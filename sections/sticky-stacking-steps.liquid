    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Under Title",
      "default": "We analyse your biomarkers and translate them into a personalised supplement plan built just for you."
    }
  ],
  "blocks": [
    {
      "type": "step_card",
      "name": "Step Card",
      "settings": [
        {
          "type": "header",
