        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background",
          "default": "#f7f5ef"
        },
        {
          "type": "color",
          "id": "card_text_color",
          "label": "Card Text Color",
          "default": "#111111"
        },
        {
          "type": "header",
          "content": "Card Content"
        },
        {
          "type": "text",
          "id": "step_tag",
          "label": "Step Tag",
          "default": "Step 1: Book Your Plan"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Upload/book blood test"
        },
        {
          "type": "text",
          "id": "bullet1",
          "label": "Checklist Point 1",
          "default": "Upload recent medical records (last 3 months)"
        },
        {
          "type": "text",
          "id": "bullet2",
          "label": "Checklist Point 2",
          "default": "Or schedule at home blood test appointment"
        },
        {
          "type": "text",
          "id": "bullet3",
          "label": "Checklist Point 3",
          "default": "NABL & CAP accredited partner lab"
        },
        {
          "type": "text",
          "id": "bullet4",
          "label": "Checklist Point 4"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Start Your Plan"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Showcase Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky Stacking Steps",
      "blocks": [
        {
          "type": "step_card",
          "settings": {
            "step_tag": "Step 1: Book Your Plan",
            "title": "Upload/book blood test",
            "bullet1": "Upload recent medical records (last 3 months)",
            "bullet2": "Or schedule at home blood test appointment",
            "bullet3": "NABL & CAP accredited partner lab",
            "btn_text": "Start Your Plan"
          }
        },
        {
          "type": "step_card",
          "settings": {
