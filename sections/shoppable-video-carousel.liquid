



<section class="section" style="background-color: {{ section.settings.bg_color }};">
  <div class="svc-container svc-wrapper">
    {% if section.settings.heading != blank %}
      <h2 class="svc-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="svc-carousel">
      <div class="svc-track">
        {% for block in section.blocks %}
          <div class="svc-card">
            <div class="svc-media-wrapper" data-video-modal-target="modal-{{ block.id }}-1">
              {% if block.settings.video != blank %}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'svc-video' }}
              {% endif %}

              <!-- Speaker Button -->
              <button class="svc-speaker" aria-label="Toggle sound">
                <svg class="icon-muted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="20" height="20">
                  <path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06A8.99 8.99 0 0 0 17.73 19L19 20.27 20.27 19 5.27 4 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                </svg>
                <svg class="icon-unmuted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="20" height="20" style="display:none;">
                  <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                </svg>
              </button>

              <div class="svc-products-row">
                {% for i in (1..3) %}
                  {% assign prod_key = 'product_' | append: i %}
                  {% assign product_item = block.settings[prod_key] %}
                  {% if product_item != blank %}
                    {% assign second_image = product_item.images[1] %}
                    <button type="button"
                            class="svc-prod-thumb"
                            data-modal-target="modal-{{ block.id }}-{{ i }}"
                            aria-label="Quick view {{ product_item.title }}">
                      {% if second_image != blank %}
                        <img src="{{ second_image | image_url: width: 100 }}" alt="{{ product_item.title }}">
                      {% else %}
                        <img src="{{ product_item.featured_image | image_url: width: 100 }}" alt="{{ product_item.title }}">
                      {% endif %}
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            <div class="svc-info">
              <h3 class="svc-title">{{ block.settings.title }}</h3>

              {%- assign total_price = 0 -%}
              <form method="post" action="/cart/add" class="svc-add-form"
                    data-id-1="{{ block.settings.product_1.variants.first.id }}"
                    data-id-2="{{ block.settings.product_2.variants.first.id }}"
                    data-id-3="{{ block.settings.product_3.variants.first.id }}">

                {% for i in (1..3) %}
                  {% assign prod_key = 'product_' | append: i %}
                  {% if block.settings[prod_key] != blank %}
                    {% assign total_price = total_price | plus: block.settings[prod_key].price %}
                  {% endif %}
                {% endfor %}

                <p class="svc-price">{{ total_price | money }}</p>
                <button type="submit" class="svc-btn">ADD TO CART</button>
              </form>
            </div>
          </div>

          <!-- ===================== QUICK-VIEW MODALS (one per product on this card) ===================== -->
          {% for i in (1..3) %}
            {% assign prod_key = 'product_' | append: i %}
            {% assign p = block.settings[prod_key] %}
            {% if p != blank %}
              {% assign modal_id = 'modal-' | append: block.id | append: '-' | append: i %}
              {% assign benefits = p.metafields.custom.benefits.value %}
              {% assign icons = p.metafields.custom.benefit_icon.value %}
              {% assign tags = p.metafields.custom.custom_tags_products.value %}
              {% assign blend_items = p.metafields.custom.blend_within_item.value %}
              {% assign blend_count = blend_items | size %}

              <div class="svc-modal-overlay" id="{{ modal_id }}" data-svc-modal hidden>

                <!-- Prev / Next navigation between reels (desktop + mobile) -->
                <button type="button" class="svc-modal-nav svc-modal-nav-prev" data-modal-nav="prev" aria-label="Previous reel">‹</button>
                <button type="button" class="svc-modal-nav svc-modal-nav-next" data-modal-nav="next" aria-label="Next reel">›</button>

                <div class="svc-modal">
                  <button type="button" class="svc-modal-close" data-modal-close aria-label="Close">&times;</button>
                   <button class="svc-modal-speaker" aria-label="Toggle sound" data-modal-speaker>
                        <svg class="icon-muted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="20" height="20">
                          <path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06A8.99 8.99 0 0 0 17.73 19L19 20.27 20.27 19 5.27 4 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                        </svg>
                        <svg class="icon-unmuted" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="20" height="20" style="display:none;">
                          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                        </svg>
                    </button>

                  <div class="svc-modal-body">
                    <div class="svc-modal-media">
                      {% if block.settings.video != blank %}
                        {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'svc-modal-video' }}
                      {% elsif p.featured_media.media_type == 'video' %}
                        {{ p.featured_media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'svc-modal-video' }}
                      {% else %}
                        {% if p.images.size > 1 %}
                          <div class="svc-modal-slider" data-svc-image-slider>
                            <div class="svc-modal-slides-wrap">
                              {% for img in p.images %}
                                <div class="svc-modal-slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}">
                                  <img src="{{ img | image_url: width: 800 }}" alt="{{ p.title }}" class="svc-modal-image">
                                </div>
                              {% endfor %}
                            </div>
                            <div class="svc-modal-dots">
                              {% for img in p.images %}
                                <button type="button" class="svc-modal-dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
                              {% endfor %}
                            </div>
                          </div>
                        {% else %}
                          <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title }}" class="svc-modal-image">
                        {% endif %}
                      {% endif %}
                      <!-- Speaker/Sound Toggle -->
                     

                   

                      <!-- ===== Mobile compact overlay card (visual only — mirrors desktop info) ===== -->
                      <div class="svc-modal-mobile-info">
                        <img src="{{ p.featured_image | image_url: width: 100 }}" alt="{{ p.title }}" class="svc-modal-mobile-thumb">
                        <div class="svc-modal-mobile-text">
                          <h4 class="svc-modal-mobile-title">{{ p.title }}</h4>
                          <span class="svc-modal-mobile-price">{{ p.price | money }}</span>
                        </div>
                        <button type="button" class="svc-modal-mobile-shop" data-modal-mobile-shop>Shop Now</button>
                      </div>
                    </div>

                    <div class="svc-modal-details">
                      <div class="svc-modal-thumb-wrap">
                        <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title }}" class="svc-modal-thumb-img" width="2000" height="2000">
                      </div>
                      <h3 class="svc-modal-title">{{ p.title }}</h3>
                      {% if p.metafields.custom.subtitle != blank %}
                        <p class="svc-modal-subtitle">{{ p.metafields.custom.subtitle }}</p>
                      {% endif %}

                      <!-- Product tags -->
                      {% if tags != blank %}
                        <div class="product-tag_news_new">
                          {% for tag in tags %}
                            <span
                              class="product-tag_new"
                              style="
                                background-color: {{ tag.color | default: '#E37D76' }};
                                color: {{ tag.text_colour | default: '#ffffff' }};
                                border-color: {{ tag.color | default: '#d6e8d0' }};
                              "
                            >
                              {{ tag.label }}
                            </span>
                          {% endfor %}
                        </div>
                      {% endif %}

                      <div class="svc-modal-price-row">
                        <span class="svc-modal-price">{{ p.price | money }}</span>
                        {% if p.compare_at_price > p.price %}
                          <span class="svc-modal-compare-price">{{ p.compare_at_price | money }}</span>
                          {% assign discount = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price %}
                          <span class="svc-modal-save">Save {{ discount | round }}%</span>
                        {% endif %}
                      </div>

                      <!-- Variant pack selector -->
                      {% if p.variants.size > 1 %}
                        <div class="svc-variant-select">
                          <span class="svc-variant-label">Pack :</span>
                          <div class="svc-variant-options" data-variant-group="{{ modal_id }}">
                            {% for variant in p.variants %}
                              <button type="button"
                                      class="svc-variant-pill{% if forloop.first %} is-active{% endif %}"
                                      data-variant-id="{{ variant.id }}"
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-compare-price="{{ variant.compare_at_price }}">
                                {{ forloop.index }}
                              </button>
                            {% endfor %}
                          </div>
                        </div>
                      {% endif %}

                      <!-- Tabs -->
                      <div class="svc-tabs">
                        <div class="svc-tab-buttons">
                          <button type="button" class="svc-tab-btn is-active" data-tab="description">Description</button>
                          <button type="button" class="svc-tab-btn" data-tab="ingredients">Ingredients</button>
                          <button type="button" class="svc-tab-btn" data-tab="howtotake">How to take</button>
                        </div>

                        <div class="svc-tab-panel is-active" data-tab-panel="description">
                          <div class="svc-modal-description">
                            {{ p.description }}
                          </div>

                          {% if benefits != blank %}
                            <div class="benefits-grid">
                              {% for item in benefits %}
                                {% assign current_index = forloop.index0 %}
                                <div class="benefit-item">
                                  {% for icon in icons %}
                                    {% if forloop.index0 == current_index %}
                                      <img src="{{ icon | image_url: width: 64 }}" alt="{{ item | escape }}" class="icon-img221" loading="lazy">
                                    {% endif %}
                                  {% endfor %}
                                  <span>{{ item }}</span>
                                </div>
                              {% endfor %}
                            </div>
                          {% endif %}
                        </div>

                        <div class="svc-tab-panel" data-tab-panel="ingredients">
                         

                          <!-- ===== Blend Within (ported) — Ingredients tab ===== -->
                          {% if blend_items != blank %}
                            <div class="svc-blend-wrap">
                              {% if section.settings.blend_heading != blank %}
                                <h3 class="svc-blend-heading">{{ section.settings.blend_heading }}</h3>
                              {% endif %}
                              {% if blend_count == 1 %}
                                <div class="svc-blend-single-wrap">
                                  <div class="svc-blend-single-card-outer">
                                    {% for item in blend_items %}
                                      <div class="svc-blend-single-card">
                                        {% if item.image != blank %}
                                          <div class="svc-blend-single-img">
                                            <img src="{{ item.image | image_url: width: 800 }}" alt="{{ item.title }}" loading="lazy">
                                          </div>
                                        {% endif %}
                                        <div class="svc-blend-single-content">
                                          {% if item.title != blank %}
                                            <h3 class="svc-blend-title">{{ item.title }}</h3>
                                          {% endif %}
                                          {% if item.description != blank %}
                                            <div class="svc-blend-desc-wrap">
                                              <div class="svc-blend-desc">{{ item.description | metafield_tag }}</div>
                                              <button type="button" class="svc-blend-read-more">Read More</button>
                                            </div>
                                          {% endif %}
                                        </div>
                                      </div>
                                    {% endfor %}
                                  </div>
                                </div>
                              {% elsif blend_count == 2 %}
                                <div class="svc-blend-two-wrap">
                                  <div class="svc-blend-two-grid">
                                    {% for item in blend_items %}
                                      <div class="svc-blend-card">
                                        {% if item.image != blank %}
                                          <div class="svc-blend-img">
                                            <img src="{{ item.image | image_url: width: 800 }}" alt="{{ item.title }}" loading="lazy">
                                          </div>
                                        {% endif %}
                                        {% if item.title != blank %}
                                          <h3 class="svc-blend-title">{{ item.title }}</h3>
                                        {% endif %}
                                        {% if item.description != blank %}
                                          <div class="svc-blend-desc-wrap">
                                            <div class="svc-blend-desc">{{ item.description | metafield_tag }}</div>
                                            <button type="button" class="svc-blend-read-more">Read More</button>
                                          </div>
                                        {% endif %}
                                      </div>
                                    {% endfor %}
                                  </div>
                                </div>
                              {% else %}
                                <!-- 3+ items: plain horizontal scroll, NO Swiper — every item renders in the DOM at once -->
                                <div class="svc-blend-flex">
                                  <div class="svc-blend-right">
                                    <div class="svc-blend-grid" data-blend-scroll>
                                      {% for item in blend_items %}
                                        <div class="svc-blend-card">
                                          {% if item.image != blank %}
                                            <div class="svc-blend-img">
                                              <img src="{{ item.image | image_url: width: 800 }}" alt="{{ item.title }}" loading="lazy">
                                            </div>
                                          {% endif %}
                                          {% if item.title != blank %}
                                            <h3 class="svc-blend-title">{{ item.title }}</h3>
                                          {% endif %}
                                          {% if item.description != blank %}
                                            <div class="svc-blend-desc-wrap">
                                              <div class="svc-blend-desc">{{ item.description | metafield_tag }}</div>
                                              <button type="button" class="svc-blend-read-more">Read More</button>
                                            </div>
                                          {% endif %}
                                        </div>
                                      {% endfor %}
                                    </div>
                                    <button type="button" class="svc-blend-prev" data-blend-scroll-btn="prev" aria-label="Scroll left">‹</button>
                                    <button type="button" class="svc-blend-next" data-blend-scroll-btn="next" aria-label="Scroll right">›</button>
                                  </div>
                                </div>
                              {% endif %}
                            </div>
                          {% endif %}
                        </div>

                        <div class="svc-tab-panel" data-tab-panel="howtotake">
                          {% if p.metafields.custom.how_to_take != blank %}
                            {{ p.metafields.custom.how_to_take.value }}
                          {% endif %}

                          <!-- ===== User Guide (ported) — How to take tab ===== -->
                          {% assign guide = p.metafields.custom.user_guide.value %}
                          {% if guide != blank %}
                            <div class="svc-guide-wrap">

                              <!-- LEFT IMAGE -->
                              {% if guide.image != blank %}
                                <div class="svc-guide-left">
                                  <img src="{{ guide.image | image_url: width: 1200 }}" alt="{{ guide.title }}" loading="lazy">
                                </div>
                              {% endif %}

                              <!-- RIGHT CONTENT -->
                              <div class="svc-guide-right">

                                <!-- HOW TO USE -->
                                {% if guide.title != blank or guide.how_to_use != blank %}
                                  <div class="svc-guide-box">
                                    <div class="svc-guidebox-padding">
                                      {% if guide.title != blank %}
                                        <h3>{{ guide.title }}</h3>
                                      {% endif %}

                                      {% if guide.how_to_use != blank %}
                                        <ul class="svc-guide-how-to-list">
                                          {% for step in guide.how_to_use.value %}
                                            {% assign step_icon = step.how_to_use_icon | default: step.value.how_to_use_icon %}
                                            {% assign step_text = step.how_to_use_text | default: step.value.how_to_use_text %}
                                            {% if step_icon != blank or step_text != blank %}
                                              <li>
                                                {% if step_icon != blank %}
                                                  <img src="{{ step_icon | image_url: width: 60 }}" alt="">
                                                {% endif %}
                                                <span>{{ step_text }}</span>
                                              </li>
                                            {% endif %}
                                          {% endfor %}
                                        </ul>
                                      {% endif %}
                                    </div>
                                  </div>
                                {% endif %}

                                <!-- WHEN TO USE -->
                                {% if guide.second_title != blank or guide.second_descripation != blank %}
                                  <div class="svc-guide-box">
                                    <div class="svc-guidebox-padding">
                                      {% if guide.second_title != blank %}
                                        <h4>{{ guide.second_title }}</h4>
                                      {% endif %}

                                      {% if guide.second_descripation != blank %}
                                        <div class="svc-guide-readmore">
                                          <p class="svc-guide-text">{{ guide.second_descripation }}</p>
                                          <button class="svc-guide-read-more-btn" type="button">Read More</button>
                                        </div>
                                      {% endif %}
                                    </div>
                                  </div>
                                {% endif %}

                          

                              </div>
                            </div>
                          {% endif %}

                       
                        </div>
                      </div>
                          <div class="svc-modal-footer">
                    <a href="{{ p.url }}" class="svc-modal-more-info">More Info</a>
                    <button type="button"
                            class="svc-modal-add-btn"
                            data-modal-add-to-cart
                            data-default-variant-id="{{ p.variants.first.id }}">
                      Add To Cart
                    </button>
               
                  </div>
                    </div>
                  </div>

              
                </div>
              </div>
            {% endif %}
          {% endfor %}

        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Floating Shoppable Video Widget (Corner Bubble) -->
  {% if section.settings.enable_floating_widget and section.blocks.size > 0 %}
    {% assign target_block = nil %}
    {% assign target_index = 1 %}
    
    {% for block in section.blocks %}
      {% if block.settings.product_1 != blank %}
        {% assign target_block = block %}
        {% assign target_index = 1 %}
        {% break %}
      {% elsif block.settings.product_2 != blank %}
        {% assign target_block = block %}
        {% assign target_index = 2 %}
        {% break %}
      {% elsif block.settings.product_3 != blank %}
        {% assign target_block = block %}
        {% assign target_index = 3 %}
        {% break %}
      {% endif %}
    {% endfor %}
    
    {% if target_block != nil and target_block.settings.video != blank %}
      {% assign float_target_modal = 'modal-' | append: target_block.id | append: '-' | append: target_index %}
      <div class="svc-floating-widget" id="svc-float-{{ section.id }}" style="display: none;">
        <div class="svc-float-bubble" data-svc-float-trigger data-target-modal="{{ float_target_modal }}">
          <button type="button" class="svc-float-close" aria-label="Close widget">&times;</button>
          {{ target_block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'svc-float-video' }}
          {% if section.settings.floating_label != blank %}
            <div class="svc-float-label">{{ section.settings.floating_label }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endif %}
</section>

<style>
.svc-wrapper { padding: 60px 0; }

.svc-heading {
  text-align: center;
  font-size: 36px;
  margin-bottom: 40px;
}

@media (max-width: 768px) {
  .svc-heading { font-size: 28px; margin-bottom: 15px; }
}

@media (max-width: 480px) {
  .svc-heading { font-size: 22px; margin-bottom: 12px; }
  .svc-wrapper { padding: 10px 0px; }
}

.svc-carousel { overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 20px; scrollbar-width: none; }
.svc-carousel::-webkit-scrollbar { display: none; }
.svc-track {
    display: flex;
    gap: 20px;
    justify-content: center;
}
.svc-card { flex: 0 0 240px; display: flex; flex-direction: column; gap: 15px; justify }
.svc-media-wrapper { position: relative; aspect-ratio: 9/16; border-radius: 12px; overflow: hidden; background: #eee; }
.svc-video { width: 100%; height: 100%; object-fit: cover; cursor: pointer; }
.svc-products-row { position: absolute; bottom: 15px; left: 10px; display: flex; gap: 8px; }
.svc-prod-thumb { width: 45px; height: 45px; border-radius: 8px; overflow: hidden; border: 2px solid #fff; background: #fff; padding: 0; cursor: pointer; }
.svc-prod-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.svc-title { font-size: 16px; margin: 0; font-weight: 600; }
.svc-price { font-size: 14px; margin: 5px 0; font-weight: 600; color: #111; }
.svc-btn { display: block; width: 100%; background: #000; color: #fff; text-align: center; padding: 12px; text-decoration: none; font-size: 12px; font-weight: bold; border-radius: 4px; border: none; cursor: pointer; transition: background 0.3s; }
.svc-btn:hover { background: #333; }

/* Speaker Button (carousel) */
.svc-speaker {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 10;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.svc-speaker:hover { background: rgba(0, 0, 0, 0.7); }

/* Speaker Button (modal) */
.svc-modal-speaker {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 11;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
  padding: 0;
}
.svc-modal-speaker:hover { background: rgba(0, 0, 0, 0.75); }

/* ===================== MODAL ===================== */
.svc-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.svc-modal-overlay[hidden] { display: none; }

  .svc-modal {
  background: #fff;
  border-radius: 12px;
  /* slightly wider modal on desktop to accommodate left-side video */
  {% comment %} max-width: 1100px; {% endcomment %}
  {% comment %} width: 100%; {% endcomment %}
  {% comment %} max-height: 90vh; {% endcomment %}
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
}

.svc-modal-close {
  position: absolute;
  top: 12px;
  right: 16px;
  z-index: 20;
