<script>
// Helper function to initialize product image slider inside modal
function initSvcImageSliders(modal) {
  const slider = modal.querySelector('[data-svc-image-slider]');
  if (!slider) return;
  
  const slides = slider.querySelectorAll('.svc-modal-slide');
  const dots = slider.querySelectorAll('.svc-modal-dot');
  
  if (slides.length <= 1) return;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      slide.classList.toggle('is-active', i === index);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
    });
  }

  // Bind click events to dots
  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const index = parseInt(dot.getAttribute('data-dot'), 10);
      showSlide(index);
    });
  });
}

// ── Shared modal-open / modal-close helpers (used by video clicks, thumbnail
//    clicks, and the prev/next reel navigation) ──────────────────────
function openSvcModal(targetId) {
  const modal = document.getElementById(targetId);
  if (!modal) return;
  modal.hidden = false;
  document.body.style.overflow = 'hidden';

  const modalVideo = modal.querySelector('.svc-modal-video');
  if (modalVideo) {
    modalVideo.muted = true;
    modalVideo.play().catch(() => {});
  }

  // Initialize image slider inside modal if present
  initSvcImageSliders(modal);

  // Make sure any Blend Within widgets inside the now-visible modal are
  // correctly measured/initialized (Read More buttons, scroll arrows).
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      initSvcBlendReadMore(modal);
      initSvcBlendScrollArrows(modal);
      initSvcGuideReadMore(modal);
    });
  });
}

function closeSvcModal(modal) {
  if (!modal || modal.hidden) return;
  modal.hidden = true;
  document.body.style.overflow = '';
  const modalVideo = modal.querySelector('.svc-modal-video');
  if (modalVideo) modalVideo.pause();
}

// ── Prev / Next navigation between reels (cycles through every quick-view
//    modal on the page in the order they appear in the DOM) ──────────
function getAllSvcModals() {
  return Array.from(document.querySelectorAll('.svc-modal-overlay'));
}

function navigateSvcModal(currentModal, direction) {
  const modals = getAllSvcModals();
  const currentIndex = modals.indexOf(currentModal);
  if (currentIndex === -1) return;

  const nextIndex = direction === 'next'
    ? (currentIndex + 1) % modals.length
    : (currentIndex - 1 + modals.length) % modals.length;

  // Open the next modal FIRST (on top, same fixed-position backdrop) and only
  // then hide the old one — this keeps the screen continuously covered so
  // there is no black/blink frame in between, and avoids restarting the
  // muted state of the next video twice.
  const nextModal = modals[nextIndex];
  nextModal.style.zIndex = 1002;
  openSvcModal(nextModal.id);
  closeSvcModal(currentModal);
  requestAnimationFrame(() => { nextModal.style.zIndex = ''; });
}

document.querySelectorAll('.svc-modal-nav').forEach(navBtn => {
  navBtn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const modal = navBtn.closest('.svc-modal-overlay');
    navigateSvcModal(modal, navBtn.getAttribute('data-modal-nav'));
  });
});

// ── Mobile "Shop Now" overlay card → scroll down to the full details panel ──
document.querySelectorAll('[data-modal-mobile-shop]').forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const modal = btn.closest('.svc-modal-overlay');
    const details = modal && modal.querySelector('.svc-modal-details');
    if (details) details.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});

// ── Speaker toggle + one-active-video logic ──────────────────────────
document.querySelectorAll('.svc-media-wrapper').forEach(wrapper => {
  const video = wrapper.querySelector('.svc-video');
  if (!video) return;
  const speakerBtn = wrapper.querySelector('.svc-speaker');
  const iconMuted = speakerBtn.querySelector('.icon-muted');
  const iconUnmuted = speakerBtn.querySelector('.icon-unmuted');

  // Click video → pause all others, play this one, and open Product 1's quick-view popup
  video.addEventListener('click', () => {
    document.querySelectorAll('.svc-video').forEach(v => {
      if (v !== video) {
        v.pause();
        const otherWrapper = v.closest('.svc-media-wrapper');
        otherWrapper.querySelector('.icon-muted').style.display = '';
        otherWrapper.querySelector('.icon-unmuted').style.display = 'none';
        v.muted = true;
      }
    });
    video.play();

    const modalTargetId = wrapper.getAttribute('data-video-modal-target');
    if (modalTargetId) openSvcModal(modalTargetId);
  });

  // Speaker button → toggle mute
  speakerBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    video.muted = !video.muted;
    iconMuted.style.display = video.muted ? '' : 'none';
    iconUnmuted.style.display = video.muted ? 'none' : '';
  });
});

// ── Quick-view modal open/close ──────────────────────────────────────
document.querySelectorAll('[data-modal-target]').forEach(thumbBtn => {
  thumbBtn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    openSvcModal(thumbBtn.getAttribute('data-modal-target'));
  });
});

document.querySelectorAll('.svc-modal-overlay').forEach(modal => {
  const closeModal = () => closeSvcModal(modal);

  modal.querySelector('[data-modal-close]')?.addEventListener('click', closeModal);

  // Click on overlay background (outside the modal box) closes it
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Escape key closes
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  // ── Modal speaker/sound toggle ──
  const modalSpeaker = modal.querySelector('[data-modal-speaker]');
  const modalVideo = modal.querySelector('.svc-modal-video');
  if (modalSpeaker && modalVideo) {
    const iconMuted = modalSpeaker.querySelector('.icon-muted');
    const iconUnmuted = modalSpeaker.querySelector('.icon-unmuted');

    modalSpeaker.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      modalVideo.muted = !modalVideo.muted;
      iconMuted.style.display = modalVideo.muted ? '' : 'none';
      iconUnmuted.style.display = modalVideo.muted ? 'none' : '';
    });
  }

  // ── Tabs ──
  const tabButtons = modal.querySelectorAll('.svc-tab-btn');
  const tabPanels = modal.querySelectorAll('.svc-tab-panel');
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      tabButtons.forEach(b => b.classList.toggle('is-active', b === btn));
      tabPanels.forEach(p => p.classList.toggle('is-active', p.getAttribute('data-tab-panel') === target));

      // Re-measure Blend Within "Read More" buttons revealed by switching tabs.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          initSvcBlendReadMore(modal);
          initSvcBlendScrollArrows(modal);
          initSvcGuideReadMore(modal);
        });
      });
    });
  });

  // ── Variant pack selector ──
  let selectedVariantId = null;
  const variantPills = modal.querySelectorAll('.svc-variant-pill');
  const priceEl = modal.querySelector('.svc-modal-price');
  const comparePriceEl = modal.querySelector('.svc-modal-compare-price');

  variantPills.forEach(pill => {
    if (pill.classList.contains('is-active')) {
      selectedVariantId = pill.getAttribute('data-variant-id');
    }
    pill.addEventListener('click', () => {
      variantPills.forEach(p => p.classList.toggle('is-active', p === pill));
      selectedVariantId = pill.getAttribute('data-variant-id');

      const newPrice = parseInt(pill.getAttribute('data-variant-price'), 10);
      const newComparePrice = parseInt(pill.getAttribute('data-variant-compare-price'), 10);

      if (priceEl && !isNaN(newPrice)) {
        priceEl.textContent = formatMoney(newPrice);
      }
      if (comparePriceEl) {
        if (newComparePrice > newPrice) {
          comparePriceEl.textContent = formatMoney(newComparePrice);
          comparePriceEl.style.display = '';
        } else {
          comparePriceEl.style.display = 'none';
        }
      }
    });
  });

  // ── Add to cart from modal ──
  const addBtn = modal.querySelector('[data-modal-add-to-cart]');
  const cartCountEl = modal.querySelector('[data-cart-count]');
  if (addBtn) {
    addBtn.addEventListener('click', () => {
      const variantId = selectedVariantId || addBtn.getAttribute('data-default-variant-id');
      if (!variantId) return;

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(res => res.json())
      .then(() => {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            if (cartCountEl) cartCountEl.textContent = cart.item_count;

            if (typeof window.openGokwikSideCart === 'function') {
              window.openGokwikSideCart();
              return;
            }

            import('@theme/events').then(({ CartUpdateEvent }) => {
              const cartDrawer = document.querySelector('cart-drawer-component');
              const event = new CartUpdateEvent(cart, 'manual-trigger', { itemCount: cart.item_count });
              document.dispatchEvent(event);
              if (cartDrawer) cartDrawer.open();
            }).catch(() => {});
          });
      })
      .catch(err => console.error('Cart error:', err));
    });
  }

  // Initialize Blend Within widgets that are already in the default-active tab (Description has none,
  // but Ingredients/How-to-take are hidden by default — they'll init on first tab switch above).
  initSvcBlendReadMore(modal);
  initSvcBlendScrollArrows(modal);
  initSvcGuideReadMore(modal);
});

// Basic money formatter fallback (adjust to match your store's currency format if needed)
function formatMoney(cents) {
  return '₹' + (cents / 100).toFixed(0);
}

// ── Add to cart with GoKwik support (card-level "ADD TO CART" — adds all 3 bundle items) ──
document.querySelectorAll('.svc-add-form').forEach(form => {
  form.addEventListener('submit', function(e) {
    e.preventDefault();

    const productIds = [
      this.getAttribute('data-id-1'),
      this.getAttribute('data-id-2'),
      this.getAttribute('data-id-3')
    ].filter(id => id && id !== '');

    const itemsToAdd = productIds.map(id => ({ id, quantity: 1 }));

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: itemsToAdd })
    })
    .then(res => res.json())
    .then(() => {
      if (typeof window.openGokwikSideCart === 'function') {
        window.openGokwikSideCart();
        return;
      }

      import('@theme/events').then(({ CartUpdateEvent }) => {
        const cartDrawer = document.querySelector('cart-drawer-component');
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            const event = new CartUpdateEvent(cart, 'manual-trigger', { itemCount: cart.item_count });
            document.dispatchEvent(event);
            if (cartDrawer) cartDrawer.open();
          });
      });
    })
    .catch(err => console.error('Cart error:', err));
  });
});

// ── Blend Within (ported): READ MORE / READ LESS ──────────────────────
function initSvcBlendReadMore(scope) {
  scope.querySelectorAll(".svc-blend-desc-wrap").forEach(function (wrap) {
    const desc = wrap.querySelector(".svc-blend-desc");
    const btn  = wrap.querySelector(".svc-blend-read-more");
    if (!desc || !btn || btn.dataset.bound === "true") return;

    if (desc.scrollHeight > desc.clientHeight) {
      btn.style.display = "inline-block";
    }

    btn.dataset.bound = "true";
    btn.addEventListener("click", function () {
      const isExpanded = desc.classList.toggle("is-expanded");
      btn.textContent  = isExpanded ? "Read Less" : "Read More";
    });
  });
}

// ── Blend Within (no library): prev/next buttons just scroll the plain
//    flex row left/right by roughly one card's width. All items already
//    exist in the DOM at once (nothing lazily rendered like Swiper did). ──
function initSvcBlendScrollArrows(scope) {
  scope.querySelectorAll("[data-blend-scroll]").forEach(function (track) {
    const wrap = track.closest(".svc-blend-right");
    if (!wrap || wrap.dataset.scrollBound === "true") return;
    wrap.dataset.scrollBound = "true";

    const prevBtn = wrap.querySelector('[data-blend-scroll-btn="prev"]');
    const nextBtn = wrap.querySelector('[data-blend-scroll-btn="next"]');

    function scrollByCard(direction) {
      const card = track.querySelector(".svc-blend-card");
      const amount = card ? card.getBoundingClientRect().width + 16 : 240;
      track.scrollBy({ left: direction * amount, behavior: "smooth" });
    }

    prevBtn?.addEventListener("click", () => scrollByCard(-1));
    nextBtn?.addEventListener("click", () => scrollByCard(1));
  });
}

// ── User Guide (ported): READ MORE / READ LESS for "When to Use" text ──
function initSvcGuideReadMore(scope) {
  scope.querySelectorAll(".svc-guide-readmore").forEach(function (wrap) {
    const btn = wrap.querySelector(".svc-guide-read-more-btn");
    if (!btn || btn.dataset.bound === "true") return;

    btn.dataset.bound = "true";
    btn.addEventListener("click", function () {
      const isActive = wrap.classList.toggle("is-active");
      btn.textContent = isActive ? "Read Less" : "Read More";
    });
  });
}

// ── Floating Video Widget Event Listeners ──
document.addEventListener("DOMContentLoaded", function () {
  const floatWidget = document.getElementById("svc-float-{{ section.id }}");
  if (!floatWidget) return;
  const bubble = floatWidget.querySelector("[data-svc-float-trigger]");
  const closeBtn = floatWidget.querySelector(".svc-float-close");

  if (bubble && closeBtn) {
    if (localStorage.getItem("svc-float-dismissed-{{ section.id }}") === "true") {
      floatWidget.style.display = "none";
    } else {
      floatWidget.style.display = "block";
    }

    closeBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      e.preventDefault();
      floatWidget.style.display = "none";
      localStorage.setItem("svc-float-dismissed-{{ section.id }}", "true");
    });

    bubble.addEventListener("click", () => {
      const targetModalId = bubble.getAttribute("data-target-modal");
      if (targetModalId) openSvcModal(targetModalId);
    });
  }
});
</script>

