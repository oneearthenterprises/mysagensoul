<section class="sage-product-hero-carousel">

  <div class="sageHeroCarousel" id="sageHero-{{ section.id }}">

    <div class="sage-hero-track" id="sageHeroTrack-{{ section.id }}">

      {% for block in section.blocks %}

        <div class="sage-hero-slide">

          <a
            href="{{ block.settings.banner_link }}"
            class="sage-hero-banner-item"
          >

            <picture>
              {% if block.settings.mobile_image != blank %}
                <!-- Mobile source -->
                <source
                  media="(max-width: 768px)"
                  srcset="
                    {{ block.settings.mobile_image | image_url: width: 320 }} 320w,
                    {{ block.settings.mobile_image | image_url: width: 360 }} 360w,
                    {{ block.settings.mobile_image | image_url: width: 390 }} 390w,
                    {{ block.settings.mobile_image | image_url: width: 412 }} 412w
                  "
                >
              {% endif %}
              
              {% if block.settings.desktop_image != blank %}
                <!-- Desktop source -->
                <source
                  media="(min-width: 769px)"
                  srcset="
                    {{ block.settings.desktop_image | image_url: width: 768 }} 768w,
                    {{ block.settings.desktop_image | image_url: width: 1024 }} 1024w,
                    {{ block.settings.desktop_image | image_url: width: 1440 }} 1440w,
                    {{ block.settings.desktop_image | image_url: width: 1600 }} 1600w,
                    {{ block.settings.desktop_image | image_url: width: 2000 }} 2000w
                  "
                >
              {% endif %}

              <!-- Fallback Img -->
              {%- assign fallback_image = block.settings.desktop_image | default: block.settings.mobile_image -%}
              {% if fallback_image != blank %}
                <img
                  src="{{ fallback_image | image_url: width: 1440 }}"
                  alt="Banner"
                  class="sage-responsive-banner"
                  {% if forloop.first %}
                    loading="eager"
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                >
              {% endif %}
            </picture>

          </a>

        </div>

      {% endfor %}

    </div>

    <!-- PAGINATION -->
    <div class="sage-hero-pagination" id="sageHeroPagination-{{ section.id }}"></div>

  </div>

</section>

<style>

.sage-product-hero-carousel{
  width:100%;
  overflow:hidden;
}

/* CAROUSEL */

.sageHeroCarousel{
  width:100%;
  overflow:hidden;
  position:relative;
}

/* TRACK */

.sage-hero-track{
  display:flex;
  transition:transform 0.7s ease;
  will-change:transform;
  cursor:grab;
  user-select:none;
}

.sageHeroCarousel.is-dragging .sage-hero-track{
  cursor:grabbing;
}

/* SLIDE */

.sage-hero-slide{
  flex:0 0 100%;
  min-width:100%;
}

.sage-hero-banner-item{
  display:block;
  width:100%;
  overflow:hidden;
}

/* IMAGE */

.sage-hero-banner-item img{
  width:100%;
  height:auto !important;
  object-fit:cover;
  display:block;
}




/* PAGINATION */

.sage-hero-pagination{
  position:absolute;
  left:0;
  right:0;
  bottom:14px;
  display:none;
  justify-content:center;
  gap:8px;
  z-index:5;
}

.sage-hero-pagination .sage-hero-dot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:#fff;
  opacity:.4;
  cursor:pointer;
  transition:width .2s, opacity .2s, border-radius .2s;
}

.sage-hero-pagination .sage-hero-dot.is-active{
  width:30px;
  border-radius:20px;
  opacity:1;
}


</style>

<script>
(function () {
  var track = document.getElementById("sageHeroTrack-{{ section.id }}");
  var pagination = document.getElementById("sageHeroPagination-{{ section.id }}");
  var wrap = document.getElementById("sageHero-{{ section.id }}");
  if (!track) return;

  var realSlides = Array.prototype.slice.call(track.children);
  var total = realSlides.length;
  if (total <= 1) return;

  var delay = 3000;
  var timer = null;

  // build pagination dots (based on REAL slides only)
  realSlides.forEach(function (slide, i) {
    var dot = document.createElement("span");
    dot.className = "sage-hero-dot" + (i === 0 ? " is-active" : "");
    dot.addEventListener("click", function () {
      goToReal(i);
      restart();
    });
    pagination.appendChild(dot);
  });
  var dots = Array.prototype.slice.call(pagination.children);

  // --- CLONE first & last slide so the loop never has to "jump" across the whole strip ---
  var firstClone = realSlides[0].cloneNode(true);
  var lastClone = realSlides[total - 1].cloneNode(true);
  firstClone.classList.add("is-clone");
  lastClone.classList.add("is-clone");
  firstClone.setAttribute("aria-hidden", "true");
  lastClone.setAttribute("aria-hidden", "true");
  track.appendChild(firstClone);
  track.insertBefore(lastClone, track.firstChild);

  // Force browser to evaluate cloned picture sources to prevent white screen flash
  [firstClone, lastClone].forEach(function (clone) {
    var sources = clone.querySelectorAll("source");
    sources.forEach(function (source) {
      if (source.srcset) source.srcset = source.srcset;
    });
    var imgs = clone.querySelectorAll("img");
    imgs.forEach(function (img) {
      if (img.src) img.src = img.src;
    });
  });

  // trackIndex 0 = lastClone, 1..total = real slides, total+1 = firstClone
  var trackIndex = 1;

  function setTransform(index, withTransition) {
    track.style.transition = withTransition ? "transform 0.7s ease" : "none";
    track.style.transform = "translateX(-" + (index * 100) + "%)";
  }

  function updateDots() {
    var realIndex = ((trackIndex - 1) + total) % total;
    dots.forEach(function (dot, i) {
      dot.classList.toggle("is-active", i === realIndex);
    });
  }

  // place track at the correct starting position with no transition
  setTransform(trackIndex, false);
  updateDots();

  function step(direction) {
    trackIndex += direction;
    setTransform(trackIndex, true);
    updateDots();
  }

  // after each slide animation, if we've landed on a clone, silently
  // snap back to the matching real slide with no transition (invisible to the eye)
  track.addEventListener("transitionend", function (e) {
    if (e.propertyName && !e.propertyName.includes("transform")) return;
    if (trackIndex === total + 1) {
      trackIndex = 1;
      setTransform(trackIndex, false);
    } else if (trackIndex === 0) {
      trackIndex = total;
      setTransform(trackIndex, false);
    }
  });

  function goToReal(realIndex) {
    // jump straight to a specific real slide (used by dots) - single smooth move
    trackIndex = realIndex + 1;
    setTransform(trackIndex, true);
    updateDots();
  }

  function next() {
    step(1);
  }

  function start() {
    timer = setInterval(next, delay);
  }

  function stop() {
    if (timer) clearInterval(timer);
    timer = null;
  }

  function restart() {
    stop();
    start();
  }

  start();

  // pause autoplay on hover, resume on leave
  wrap.addEventListener("mouseenter", stop);
  wrap.addEventListener("mouseleave", start);

  // --- CURSOR / TOUCH DRAG TO SLIDE (always exactly one slide at a time) ---
  var isDragging = false;
  var startX = 0;
  var startY = 0;
  var dragPercent = 0;
  var wrapWidth = 1;
  var moved = false; // true once the pointer has actually moved past a small threshold
  var MOVE_THRESHOLD = 6; // px of movement before we treat this as a drag, not a click

  function pointerDown(e) {
    isDragging = true;
    moved = false;
    stop();
    var point = e.touches ? e.touches[0] : e;
    startX = point.clientX;
    startY = point.clientY;
    wrapWidth = wrap.getBoundingClientRect().width || 1;
    track.style.transition = "none";
    wrap.classList.add("is-dragging");
  }

  function pointerMove(e) {
    if (!isDragging) return;
    var point = e.touches ? e.touches[0] : e;
    var deltaX = point.clientX - startX;
    var deltaY = point.clientY - startY;

    if (!moved && Math.abs(deltaX) > MOVE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
      moved = true;
    }
    if (!moved) return; // let vertical scroll happen normally, don't drag yet

    if (e.cancelable) e.preventDefault(); // stop page scroll once we know it's a horizontal drag
    dragPercent = (deltaX / wrapWidth) * 100;
    setTransform(trackIndex - (dragPercent / 100), false);
  }

  function pointerUp() {
    if (!isDragging) return;
    isDragging = false;
    wrap.classList.remove("is-dragging");

    if (moved) {
      var threshold = 15; // % of slide width needed to trigger a slide change
      if (dragPercent <= -threshold) {
        step(1);
      } else if (dragPercent >= threshold) {
        step(-1);
      } else {
        setTransform(trackIndex, true); // snap back to current slide
      }
    }
    dragPercent = 0;
    restart();
    // keep "moved" true through the click event that follows mouseup/touchend,
    // then clear it right after so a normal (non-drag) click still works next time
    setTimeout(function () { moved = false; }, 0);
  }

  function suppressClickIfDragged(e) {
    if (moved) {
      e.preventDefault();
      e.stopPropagation();
    }
  }

  // mouse
  wrap.addEventListener("mousedown", pointerDown);
  window.addEventListener("mousemove", pointerMove);
  window.addEventListener("mouseup", pointerUp);

  // touch
  wrap.addEventListener("touchstart", pointerDown, { passive: true });
  wrap.addEventListener("touchmove", pointerMove, { passive: false });
  wrap.addEventListener("touchend", pointerUp);

  // prevent image ghost-drag while dragging
  wrap.addEventListener("dragstart", function (e) { e.preventDefault(); });

  // stop the banner link from navigating when the pointer action was actually a drag
  var links = wrap.querySelectorAll("a.sage-hero-banner-item");
  links.forEach(function (link) {
    link.addEventListener("click", suppressClickIfDragged, true);
  });
})();
</script>

{% schema %}
{
  "name": "sage Hero Carousel",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Banner"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Banner"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Banner Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "sage Hero Carousel"
    }
  ]
}
{% endschema %}
