<section class="process-features-section section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="features-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="features-grid">
      {% for block in section.blocks %}
        <div class="feature-card" {{ block.shopify_attributes }}>

          {% if block.settings.icon != blank %}
            <div class="feature-icon">
              {{
                block.settings.icon
                | image_url: width: 200
                | image_tag: loading: 'lazy'
              }}
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="feature-description">
              {{ block.settings.description }}
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </div>
</section>

 <style>
.process-features-section{
  padding:80px 20px;
}

.features-heading{
  text-align:center;
  font-size:42px;
  font-weight:700;
  margin-bottom:60px;
}

.features-grid{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:40px;
    position: relative;
}
.features-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 40px;
}

.features-grid::before {
  content: "";
  position: absolute;
  top: 50px;
  left: 8%;
  right: 8%;
  border-top: 2px dashed #c4c4c4;
  z-index: 0;
}

.feature-card {
  position: relative;
  z-index: 1;
}

.feature-card {
    display: flex;
    flex-direction: column;
    text-align: center;
    height: 100%;
    align-items: center;
    justify-content: space-around;
}

.feature-icon{
  width:100px;
  height:100px;
  margin:0 auto 25px;
  border:1px solid #cfcfcf;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#333333;
}

.feature-icon img{
  width:60px;
  height:60px;
  object-fit:contain;
}

.feature-card h3 {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 15px;
    color: #000;
    margin-top: 0px;
}

.feature-description{
  font-size:16px;
  line-height:1;
  color:#333;

}

/* Tablet */
@media(max-width:991px){
.features-grid::before{
display:none;
}
  .features-grid{
    grid-template-columns:repeat(2,1fr);
    gap:50px 30px;
  }

  .feature-card h3{
    font-size:26px;
  }

  .feature-description{
    font-size:18px;
  }
}

/* Mobile */
@media(max-width:767px){
.process-features-section {
    padding: 30px 00px;
}
  .features-heading{
    font-size:24px;
    margin-bottom:40px;
  }

  .features-grid{
    grid-template-columns:1fr;
    gap:40px;
  }

  .feature-icon{
    width:100px;
    height:100px;
  }

  .feature-card h3{
    font-size:22px;
  }

  .feature-description{
    font-size:16px;
  }
}
</style>

{% schema %}
{
  "name": "Process Steps",
  "tag": "section",
  "class": "process-steps",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Process"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "range",
          "id": "step_number",
          "label": "Step Number",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 1
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add your description here."
        },
        {
          "type": "color",
          "id": "box_color",
          "label": "Card Background Color",
          "default": "#0066B3"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "shadow_color",
          "label": "Shadow Color",
          "default": "#0066B3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process Steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
