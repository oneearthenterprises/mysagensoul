<section class="vcat-section section">
  <div class="page-width">
      {% if section.settings.heading != blank %}
        <div class="vcat-title-block">
          <h2 class="vcat-heading">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
    <div class="vcat-wrapper">

      <div class="vcat-slider-outer">

        <!-- Skeleton loader: overlays the slider until Swiper finishes initializing -->
        <div class="vcat-skeleton" id="vcatSkeleton-{{ section.id }}">
          {% for i in (1..6) %}
            <div class="vcat-skel-card">
              <div class="vcat-skel-circle"></div>
              <div class="vcat-skel-pill"></div>
            </div>
          {% endfor %}
        </div>

        <div class="swiper vcatSwiper" id="vcatSwiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% assign col = block.settings.collection %}
              {% assign badge_text = block.settings.label_text %}
              {% assign badge_color = block.settings.label_color %}
              {% assign btn_text = block.settings.button_text %}

              {% if col != blank %}
                <div class="swiper-slide">
                  <a href="{{ col.url }}" class="vcat-card">

                    <div class="vcat-bubble">
                      <div class="vcat-green-circle"></div>

                      {% if col.image %}
                        <img
                          src="{{ col.image | image_url: width: 400 }}"
                          alt="{{ col.title }}"
                          width="200"
                          height="220"
                          loading="lazy"
                          class="vcat-product-img"
                        >
                      {% elsif col.products.first.featured_image %}
                        <img
                          src="{{ col.products.first.featured_image | image_url: width: 400 }}"
                          alt="{{ col.title }}"
                          width="200"
                          height="220"
                          loading="lazy"
                          class="vcat-product-img"
                        >
                      {% endif %}
                    </div>

                    <div class="vcat-pill-label" {% if badge_text != blank and badge_color != blank %}style="border-color: {{ badge_color }}; color: {{ badge_color }};"{% endif %}>
                      {{ btn_text | default: col.title }}
                      <span class="vcat-pill-arrow">›</span>
                    </div>

                    {% if badge_text != blank %}
                      <span class="vcat-badge" style="background-color: {{ badge_color }};">
                        {{ badge_text }}
                      </span>
                    {% endif %}

                  </a>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <div class="swiper-button-next vcat-nav-next"></div>
          <div class="swiper-button-prev vcat-nav-prev"></div>
          <div class="swiper-pagination vcat-dots"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Root Variables ── */
  .vcat-section {
    --vcat-green: #000000ff;
    --vcat-green-circle: #d4edbb;
    --vcat-text: #ffffffff;
    --vcat-subtext: #555;
    --vcat-pill-border: #d0d0d0;
    --vcat-pill-bg: #000000ff;
    --vcat-shadow: 0 6px 24px rgba(0,0,0,0.09);
    --vcat-transition: 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: 20px 0 20px;
    overflow: hidden;
    background: #fff;
  }

  /* ── Layout ── */
  .vcat-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 48px;
  }

  .vcat-title-block {
    text-align: center;
    padding-top: 20px;
  }

  .vcat-heading {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--vcat-green);
    margin: 0 0 16px;
  }

  /* ── Slider Container ── */
  .vcat-slider-outer {
    flex: 1;
    min-width: 0;
    position: relative;
    padding: 0px;
    overflow: hidden;
  }

  .vcatSwiper {
    overflow: visible !important;
    padding: 25px 0 25px !important;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .vcatSwiper.vcat-ready {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Skeleton Loader ──
     Positioned absolutely on top of the swiper (same box) instead of
     stacking below it, so it never adds extra height / blank space. */
  .vcat-skeleton {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    background: #fff;
    overflow: hidden;
  }

  .vcat-skeleton.vcat-hide {
    display: none;
  }

  .vcat-skel-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    flex: 0 0 auto;
    width: 150px;
  }

  .vcat-skel-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
    background-size: 400% 100%;
    animation: vcat-shimmer 1.4s ease-in-out infinite;
  }

  .vcat-skel-pill {
    width: 100%;
    height: 34px;
    border-radius: 50px;
    background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
    background-size: 400% 100%;
    animation: vcat-shimmer 1.4s ease-in-out infinite;
  }

  @keyframes vcat-shimmer {
    0% { background-position: 100% 0; }
    100% { background-position: 0 0; }
  }

  @media screen and (max-width: 1024px) {
    .vcat-skel-card:nth-child(n+5) { display: none; }
  }
  @media screen and (max-width: 768px) {
    .vcat-skel-card:nth-child(n+4) { display: none; }
    .vcat-skel-circle { width: 110px; height: 110px; }
    .vcat-skel-card { width: 110px; }
  }
  @media screen and (max-width: 480px) {
    .vcat-skel-card:nth-child(n+3) { display: none; }
    .vcat-skel-circle { width: 90px; height: 90px; }
    .vcat-skel-card { width: 90px; }
  }

  /* ── Card ── */
  .vcat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    gap: 20px;
    transition: transform var(--vcat-transition);
  }

  .vcat-card:hover {
    transform: translateY(-6px);
  }

  /* ── Bubble: green circle + floating product ── */
  .vcat-bubble {
    position: relative;
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vcat-green-circle {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 130px;
    height: 130px;
    border-radius: 50%;
    z-index: 0;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .vcat-product-img {
    position: relative;
    z-index: 1;
    width: 150px;
    height: 160px;
    object-fit: cover;
    object-position: bottom center;
    margin-bottom: -10px;
    transition: transform var(--vcat-transition);
  }

  .vcat-card:hover .vcat-product-img {
    transform: translateY(-6px) scale(1.04);
  }

  /* ── Pill Label ── */
  .vcat-pill-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border: 1.5px solid var(--vcat-pill-border);
    border-radius: 50px;
    background: var(--vcat-pill-bg);
    font-size: 15px;
    font-weight: 500;
    color: var(--vcat-text);
    white-space: nowrap;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    width: 100%;
    justify-content: center;
  }

  .vcat-card:hover .vcat-pill-label {
    border-color: var(--vcat-green);
    color: var(--vcat-text);
    box-shadow: 0 4px 14px rgba(141,198,63,0.18);
  }

  .vcat-pill-arrow {
    font-size: 16px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .vcat-card:hover .vcat-pill-arrow {
    transform: translateX(3px);
  }

  /* ── Optional Badge ── */
  .vcat-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 10px;
    font-weight: 700;
    color: #fff;
    padding: 3px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    z-index: 3;
  }

  /* ── Nav Arrows ── */
  .vcat-slider-outer .vcat-nav-next,
  .vcat-slider-outer .vcat-nav-prev {
    width: 40px;
    height: 40px;
    background: #fff;
    border: 1.5px solid #e4e4e4;
    border-radius: 50%;
    color: #444;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    top: 38%;
    transition: all 0.25s ease;
  }

  .vcat-slider-outer .vcat-nav-next::after,
  .vcat-slider-outer .vcat-nav-prev::after {
    font-size: 14px;
    font-weight: 700;
  }

  .vcat-slider-outer .vcat-nav-next:hover,
  .vcat-slider-outer .vcat-nav-prev:hover {
    background: var(--vcat-green);
    border-color: var(--vcat-green);
    color: #fff;
    box-shadow: 0 6px 18px rgba(141,198,63,0.32);
  }

  .vcat-slider-outer .vcat-nav-prev { left: 0; }
  .vcat-slider-outer .vcat-nav-next { right: 0; }

  /* ── Pagination Dots ── */
  .vcat-slider-outer .vcat-dots {
    bottom: 4px !important;
  }

  .vcat-slider-outer .swiper-pagination-bullet {
    width: 7px;
    height: 7px;
    background: #ccc;
    opacity: 1;
    transition: all 0.3s ease;
  }

  .vcat-slider-outer .swiper-pagination-bullet-active {
    background: var(--vcat-green);
    width: 22px;
    border-radius: 4px;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 1024px) {
    .vcat-wrapper { gap: 32px; }
    .vcat-title-block { width: 160px; }
    .vcat-heading { font-size: 26px; }
    .vcat-bubble { width: 130px; height: 130px; }
    .vcat-green-circle { width: 110px; height: 110px; }
    .vcat-product-img { width: 100px; height: 120px; }
    .vcat-slider-outer { padding: 0px; }
  }

  @media screen and (max-width: 768px) {
    .vcat-nav-prev { display: none; }
    .vcat-nav-next { display: none; }
    .vcat-section { padding: 24px 0 10px; }
    .vcat-wrapper { flex-direction: column; gap: 20px; }
    .vcat-title-block { width: 100%; text-align: center; }
    .vcat-heading::after { margin: 12px auto 0; }
    .vcat-slider-outer { padding: 0px; width: 100%; }
    .vcat-bubble { width: 110px; height: 110px; }
    .vcat-green-circle { width: 95px; height: 95px; }
    .vcat-product-img { width: 82px; height: 100px; }
    .vcat-pill-label { font-size: 11px; padding: 5px 12px; }
  }

  @media screen and (max-width: 480px) {
    .vcat-bubble { width: 90px; height: 90px; }
    .vcat-green-circle { width: 78px; height: 78px; }
    .vcat-product-img { width: 100px; height: 100px; }
    .vcat-pill-label { font-size: 10px; padding: 4px 10px; }
    .vcat-slider-outer { padding: 0px; }
  }
</style>

<script>
  (function () {
    function initVcatSwiper() {
      var wrapperEl = document.getElementById('vcatSwiper-{{ section.id }}');
      var skeletonEl = document.getElementById('vcatSkeleton-{{ section.id }}');
      if (!wrapperEl) return;

      function revealSlider() {
        if (skeletonEl) skeletonEl.classList.add('vcat-hide');
        wrapperEl.classList.add('vcat-ready');
      }

      // Fallback: if Swiper library or init fails for any reason,
      // still remove the skeleton after 2.5s so section never stays "broken".
      var fallback = setTimeout(revealSlider, 2500);

      var isHomePage = {% if template == 'index' or template.name == 'index' or request.page_type == 'index' %}true{% else %}false{% endif %};
      var options = {
        slidesPerView: 1.8,
        spaceBetween: 14,
        loop: true,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false
        },
        navigation: {
          nextEl: wrapperEl.querySelector('.vcat-nav-next'),
          prevEl: wrapperEl.querySelector('.vcat-nav-prev')
        },
        pagination: {
          el: wrapperEl.querySelector('.vcat-dots'),
          clickable: true
        },
        breakpoints: {
          480: { slidesPerView: 2.5 },
          768: { slidesPerView: 3.5 },
          1024: { slidesPerView: 5.5 }
        }
      };

      if (isHomePage) {
        new CustomSlider(wrapperEl, options);
      } else {
        new Swiper(wrapperEl, options);
      }
      clearTimeout(fallback);
      revealSlider();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVcatSwiper);
    } else {
      initVcatSwiper();
    }
  })();
</script>

{% schema %}
{
  "name": "Vilvah Category Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Badge Text",
          "info": "Optional top badge (e.g., New, Sale)"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Badge Color",
          "default": "#8DC63F"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vilvah Category Carousel",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
