            "accordion_row_Qqy8an": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is Sage & Soul?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_bYXixT": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Sage & Soul is an Indian herbal wellness brand dedicated to creating premium Herbal Wellness Infusions made from carefully selected herbs, flowers, fruits, and Ayurvedic botanicals. Our products are designed to complement a balanced lifestyle by offering delicious, caffeine-free wellness beverages that fit easily into everyday routines. Every blend is thoughtfully crafted to deliver natural flavour, aroma, and quality while helping people enjoy simple wellness habits through herbal infusions rather than sugary or heavily processed drinks.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
