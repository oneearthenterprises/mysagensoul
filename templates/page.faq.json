            "accordion_row_pGnMeN": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What does Sage & Soul specialize in?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_PcRGji": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Sage & Soul specializes in premium Herbal Wellness Infusions, herbal teas, botanical wellness blends, flower infusions, detox-inspired herbal drinks, and Ayurvedic wellness beverages. Our collection includes blends designed for daily wellness, relaxation, focus, metabolism support, immunity support, skin wellness, digestive wellness, and overall wellbeing. Each product is made with carefully chosen botanical ingredients and packed in premium pyramid tea bags for an exceptional brewing experience.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
