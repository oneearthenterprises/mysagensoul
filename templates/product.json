                  "settings": {
                    "custom_liquid": "<div class=\"xtara-gaurav-price-box\">\n  <span class=\"xtara-gaurav-sale-price\">\n    {{ product.price | money }}\n  </span>\n\n  {% if product.compare_at_price > product.price %}\n    <span class=\"xtara-gaurav-compare-price\">\n      {{ product.compare_at_price | money }}\n    </span>\n\n    <span class=\"xtara-gaurav-discount-badge\">\n      {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% OFF\n    </span>\n  {% endif %}\n</div>\n\n<style>\n.xtara-gaurav-price-box {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    font-family: Arial, sans-serif;\n    flex-wrap: wrap;\n    margin: 8px 0;\n}\n/* Sale Price */\n.xtara-gaurav-sale-price {\n  font-size: 36px; /* Bigger */\n  font-weight: 700;\n  color: #222222;\n  line-height: 1;\n}\n\n.xtara-gaurav-compare-price {\n    opacity: 0.9;\n    font-size: 24px;\n    font-weight: 600;\n    color: #8a8a8a;\n    text-decoration: line-through;\n    line-height: 1.2;\n    display: flex;\n    align-items: center;\n    margin: 0;\n    white-space: nowrap;\n}\n\n/* Discount Badge */\n.xtara-gaurav-discount-badge {\n  background: #4CAF50; /* Green */\n  color: #ffffff;\n  font-size: 16px;\n  font-weight: 800;\n  padding: 8px 12px;\n  border-radius: 8px;\n  line-height: 1;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Mobile Responsive */\n@media screen and (max-width: 768px) {\n  .xtara-gaurav-price-box {\n    gap: 8px;\n  }\n\n  .xtara-gaurav-sale-price {\n    font-size: 28px;\n  }\n\n  .xtara-gaurav-compare-price {\n    font-size: 16px;\n  }\n\n  .xtara-gaurav-discount-badge {\n    font-size: 12px;\n    padding: 5px 10px;\n  }\n}\n</style>"
