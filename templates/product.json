                "custom_liquid_tCWMrL": {
                  "type": "custom-liquid",
                  "name": "t:names.custom_liquid",
                  "settings": {
                    "custom_liquid": "<div class=\"read-more-wrap\">\n  <div class=\"read-more-content clamp\" id=\"descContent\">\n    {{ product.description }}\n  </div>\n\n  <button type=\"button\" class=\"read-more-btn\" onclick=\"toggleReadMore()\">\n    Read More\n  </button>\n</div>\n\n<style>\n.read-more-content{\n  overflow: hidden;\n  line-height: 1.7;\n  transition: max-height 0.6s ease-in-out;\n}\n\n/* 5 lines closed */\n.read-more-content.clamp{\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 5;\n}\n\n/* open */\n.read-more-content.active{\n  display: block;\n}\n\n.read-more-btn{\n  margin-top: 4px;\n  border: none;\n  background: #d4af37;\n  color: #fff;\n  font-weight: 600;\n  cursor: pointer;\n  padding: 8px 18px;\n  border-radius: 6px;\n  transition: 0.3s ease;\n  margin-bottom: 15px;\n}\n\n.read-more-btn:hover{\n \n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const content = document.getElementById(\"descContent\");\n  const lineHeight = parseFloat(getComputedStyle(content).lineHeight);\n  content.style.maxHeight = (lineHeight * 5) + \"px\";\n});\n\nfunction toggleReadMore() {\n  let content = document.getElementById(\"descContent\");\n  let btn = document.querySelector(\".read-more-btn\");\n\n  const lineHeight = parseFloat(getComputedStyle(content).lineHeight);\n  const closedHeight = (lineHeight * 5) + \"px\";\n\n  if(content.classList.contains(\"active\")){\n\n    /* start from full height */\n    content.style.maxHeight = content.scrollHeight + \"px\";\n\n    requestAnimationFrame(() => {\n      content.style.maxHeight = closedHeight;\n    });\n\n    setTimeout(() => {\n      content.classList.add(\"clamp\");\n      content.classList.remove(\"active\");\n    }, 600);\n\n    btn.innerText = \"Read More\";\n\n  } else {\n\n    content.classList.remove(\"clamp\");\n    content.classList.add(\"active\");\n\n    content.style.maxHeight = closedHeight;\n\n    requestAnimationFrame(() => {\n      content.style.maxHeight = content.scrollHeight + \"px\";\n    });\n\n    btn.innerText = \"Read Less\";\n  }\n}\n</script>"
